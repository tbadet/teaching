	note = {Publisher: Nature Publishing Group},
	keywords = {Plant sciences, Developmental biology},
	file = {Full Text PDF:/Users/cmaslard/Zotero/storage/4BW6NCZP/Mortada et al. - 2024 - Dissecting the complexity of local and systemic circadian communication in plants.pdf:application/pdf},
}

