@article{nievola_rapid_2017,
	title = {Rapid responses of plants to temperature changes},
	volume = {4},
	issn = {2332-8940, 2332-8959},
	url = {https://www.tandfonline.com/doi/full/10.1080/23328940.2017.1377812},
	doi = {10.1080/23328940.2017.1377812},
	abstract = {Temperature is one of the main environmental factors that affect plant metabolism. Considering that plants are sessile, their survival depends on the efﬁcient activation of resistance responses to thermal stress. In this comprehensive review, we discuss recent work on rapid biochemical and physiological adjustments, herein referred to as those occurring during the ﬁrst few hours or a few days after the beginning of the change in the ambient temperature. The short-term metabolic modulation after plant exposure to heat and cold, including chilling and freezing, is discussed. Effects on photosynthesis, cell membranes, antioxidant system, production of heat shock proteins and nitric oxide, as well as an overview of signaling events to heat or cold stress are presented. In addition, we also discuss the acclimation process that occurs when the plant acquires resistance to an increase or decrease in temperature, adjusting its homeostasis and steady-state physiology to the new temperatures. Finally, we present studies with tropical plants that aim at elucidating the effects of temperature and the identiﬁcation of the resilience levels of these plants to the expected climate changes, and which seek the development of techniques for germplasm conservation of endangered species.},
	pages = {371--405},
	number = {4},
	journaltitle = {Temperature},
	shortjournal = {Temperature},
	author = {Nievola, Catarina C. and Carvalho, Camila P. and Carvalho, Victória and Rodrigues, Edson},
	urldate = {2020-10-23},
	date = {2017-10-02},
	langid = {english},
	keywords = {heat stress 🔥},
	file = {Nievola et al. - 2017 - Rapid responses of plants to temperature changes.pdf:/Users/cmaslard/Zotero/storage/9Z4US7H7/Nievola et al. - 2017 - Rapid responses of plants to temperature changes.pdf:application/pdf},
}

