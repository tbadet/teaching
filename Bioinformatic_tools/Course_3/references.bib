@article{escola_casas_analytical_2021,
	title = {Analytical challenges and solutions for performing metabolomic analysis of root exudates},
	volume = {31},
	issn = {22141588},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2214158821000179},
	doi = {10.1016/j.teac.2021.e00130},
	series = {9.6},
	abstract = {Plant stress responses are mediated by the release of chemical compounds called exudates into the rhizosphere. These chemical substances include primary and secondary plant metabolites and play an important role in the plant defense mechanism. The identiﬁcation,[8\_TD\${IF}] characterization and study of these compounds can open the door to numerous applications, from greener agriculture to enhanced phytoremediation. This paper critically reviews the most relevant sampling strategies, analytical methodologies, and data-mining approaches to study root exudates.[9\_TD\${IF}]Common analytical techniques are grounded in mass spectrometry or nuclear mass spectrometry, but less common biospectroscopy techniques could offer a new perspective in plant metabolomics due to the minimal sample processing they require. [10\_TD\${IF}]Finally, after analysis, the collected raw data must then be analyzed by means of different multivariate and univariate statistical approaches to test biological-response hypotheses. [1\_TD\${IF}]All in all, the assessment of root exudates calls for the development of hyphenated analytical methodologies, as well as efforts to consolidate data-preprocessing workﬂows.},
	pages = {e00130},
	journaltitle = {Trends in Environmental Analytical Chemistry},
	shortjournal = {Trends in Environmental Analytical Chemistry},
