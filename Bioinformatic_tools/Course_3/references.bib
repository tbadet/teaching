	langid = {english},
	keywords = {drought🚱, heat stress 🔥, review, microbial communities🦠, cimat change},
	file = {Classen et al_2015_Direct and indirect effects of climate change on soil microbial and soil.pdf:/Users/cmaslard/Zotero/storage/UT68WIS2/Classen et al_2015_Direct and indirect effects of climate change on soil microbial and soil.pdf:application/pdf},
