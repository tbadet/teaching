	keywords = {multi-omic, water stress, sulfure, {WGCNA}},
	file = {Bonnot et al. - 2024 - Molecular signatures and associated regulators of .pdf:/Users/cmaslard/Zotero/storage/7ASMXB8X/Bonnot et al. - 2024 - Molecular signatures and associated regulators of .pdf:application/pdf},
}

@article{henriet_proteomics_2021,
