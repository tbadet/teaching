@article{lu_spatial_nodate,
	title = {Spatial Divergence of {PHR}-{PHT}1 Modules Maintains Phosphorus Homeostasis in Soybean Nodules},
	url = {http://www.plantphysiol.org/cgi/content/short/184/1/236?rss=1&utm_source=researcher_app&utm_medium=referral&utm_campaign=RESR_MRKT_Researcher_inbound},
	doi = {10.1104/pp.19.01209},
	abstract = {Maintaining phosphorus (Pi) homeostasis in nodules is the key to nodule development and nitrogen fixation, an important source of nitrogen for agriculture and ecosystems. \textit{{PHOSPHATE}-{TRANSPORTER}1} (\textit{{PHT}1}) and its regulator \textit{{PHOSPHATE}-{STARVATION}-{RESPONSE}1} (\textit{{PHR}1}), which constitute the \textit{{PHR}1-{PHT}1} module, play important roles in maintaining Pi homeostasis in different organs. However, the \textit{{PHR}1-{PHT}1} module and its functions in nodules remain unknown. We identified one \textit{{PHT}1} (\textit{{GmPHT}1;11}) and four \textit{{PHR}1} (\textit{{GmPHR}1}) homologs in soybean (\textit{Glycine max}) plants, which displayed specific expression patterns in different tissues in nodules, similar to previously reported \textit{{GmPHT}1;1} and \textit{{GmPHT}1;4}. Through the integration of different approaches, \textit{{GmPHR}-{GmPHT}1} modules were confirmed. Combining our results and previous reports, we established multiple \textit{{GmPHR}-{GmPHT}1} modules acting in the infected or noninfected tissues in nodules. A single \textit{{GmPHR}} had more than one \textit{{GmPHT}1} target, and vice versa. Therefore, overlapping and cross-talking modules monitored the wave of available Pi to maintain Pi homeostasis in nodules, which sequentially regulated nodule initiation and development. High levels of \textit{{GmPHT}1;11} enhanced Pi accumulation in nodules, increased nodule size, but decreased nodule number. Nitrogenase activity was also enhanced by \textit{{GmPHT}1;11}. Our findings uncover \textit{{GmPHR}-{GmPHT}1} modules in nodules, which expands our understanding of the mechanism of maintaining Pi homeostasis in soybean plants.},
	journaltitle = {Plant Physiology},
	author = {Lu, Mingyang and Cheng, Zhiyuan and Zhang, Xiao-Mei and Huang, Penghui and Fan, Chengming and Yu, Guolong and Chen, Fulu and Xu, Kun and Chen, Qingshan and Miao, Yuchen and Han, Yuzhen and Feng, Xianzhong and Liu, Liangyu and Fu, Yong-Fu},
	keywords = {Researcher App},
}

@article{manan_role_nodate,
	title = {Role of Glycine max {ABSCISIC} {ACID} {INSENSITIVE} 3 ({GmABI}3) in lipid biosynthesis and stress tolerance in soybean},
	url = {https://www.publish.csiro.au/rss_feed/FP19260.htm?utm_source=researcher_app&utm_medium=referral&utm_campaign=RESR_MRKT_Researcher_inbound},
	doi = {10.1071/FP19260},
	abstract = {Soybean is an important oilseed crop and primary dietary protein resource. The limited understanding of soybean oil biosynthesis has become a significant obstacle for the improvement of soybean oil production. A transcription factor {ABSCISIC} {ACID} {INSENSITIVE} 3 ({ABI}3) is known for its role in plant development and seed dormancy in many crops. The current study was aimed to functionally characterise \textit{{ABI}3} homologue in \textit{Glycine max} L. For this purpose, the \textit{{GmABI}3} gene was cloned and ectopically expressed in wildtype and \textit{abi3} mutant \textit{Arabidopsis}. The \textit{{GmABI}3} expression in the \textit{atabi3} mutant enhanced the triacylglycerol ({TAG}) content (7.3\%) in addition to modified fatty acid composition. The \textit{{GmABI}3} increased eicosenoic acid (20:1) up to 6.5\% in genetically complemented \textit{Arabidopsis} mutant seeds, which is essential for long-chain fatty acid synthesis. The transgenic \textit{{GmABI}3}/\textit{wildtype} seeds contain 34.9\% more {TAG} content compared with wildtype seeds. The results showed that \textit{{GmABI}3} is responsible for seed-specific {TAG} and long-chain fatty acid biosynthesis in soybean. The exposure to cold and heat stress and exogenous supply of abscisic acid and jasmonic acid altered the level of \textit{{GmABI}3} in treated seeds and leaves. It also concluded that \textit{{GmABI}3} could regulate stress tolerance in soybean, which applies to a wide variety of crops to deal with biological stresses.},
	journaltitle = {Functional Plant Biology},
	author = {Manan, Sehrish and Zhao, Jian},
	keywords = {Researcher App, soybean🌿, heat stress 🔥, flavonoid, hormones},
	file = {Manan et Zhao - 2021 - Role of Glycine max ABSCISIC ACID INSENSITIVE 3 (G.pdf:/Users/cmaslard/Zotero/storage/ZM7M6ET4/Manan et Zhao - 2021 - Role of Glycine max ABSCISIC ACID INSENSITIVE 3 (G.pdf:application/pdf},
}

@article{choudhary_long-term_nodate,
	title = {Long-term effects of organic manure and inorganic fertilization on biological soil quality indicators of soybean-wheat rotation in the Indian mid-Himalaya},
	url = {https://www.sciencedirect.com/science/article/pii/S0929139320306831?dgcid=rss_sd_all&utm_source=researcher_app&utm_medium=referral&utm_campaign=RESR_MRKT_Researcher_inbound},
	doi = {10.1016/j.apsoil.2020.103754},
	abstract = {{\textless}p{\textgreater}A field experiment was accompanied to scrutinize the effect of long-term (21-year) mineral and organic manure fertilizer treatments on carbon mineralization, glomalin related soil protein and some microbial characteristics of arable soils in Indian mid-Himalaya. The experiment was initiated in 1995 includes six treatments: Control, N 120, {NPK}, {FYM}, N + {FYM} and {NPK} + {FYM}. Long-term chemical fertilization has been reported to negative effects on soil biological properties, however, the impact of combined use of organic and inorganic fertilization on soil biological properties and its relationship remains poorly understood. Results showed that integrated use of organic and inorganic ({NPK} + {FYM}) for 21 years significantly increased in carbon mineralization, easily extractable glomalin related soil protein ({EEGRSP}) and total glomalin related soil protein ({TGRSP}). Soil microbial indices (microbial quotient: {\textless}em{\textgreater}q{\textless}/em{\textgreater}{MIC}, microbial metabolic quotient: {\textless}em{\textgreater}q{\textless}/em{\textgreater}{CO}$_{\textrm{2}}$ and metabolic potential: {MP}) were enhanced in the {NPK} + {FYM} treatment as compared to rest of the treatments. The activities of seven enzymes, viz. dehydrogenase ({DHA}), β-glucosidase (β-{GA}), invertase ({IA}), acid phosphatase (Acid-{PA}), alkaline phosphatase (Alkaline-{PA}), arylsulphatase ({ASA}) and urease activity ({UA}) were significantly influenced by the application of {NPK} + {FYM} as compared rest of treatments. Soil fertilization with {NPK} and {FYM} was significantly higher fluorescein diacetate assay ({FDA}) activity as compared to other treatments. Soil microbial properties had strong positive correlation with {\textless}em{\textgreater}q{\textless}/em{\textgreater}{MIC}, microbial biomass carbon ({MBC}) and soil organic carbon ({SOC}), while {\textless}em{\textgreater}q{\textless}/em{\textgreater}{CO}$_{\textrm{2}}$ had negative correlation under both soil layers. Results showed that the 21-year fertilization experiment clearly indicated that {NPK} + {FYM} embodied the best management practice ({BMPs}) for soil biological sustainability and for sustainable food production.{\textless}/p{\textgreater}},
	journaltitle = {Applied Soil Ecology},
	author = {Choudhary, Mahipal and Meena, Vijay S. and Panday, Suresh C. and Mondal, Tilak and Yadav, Ram P. and Mishra, Pankaj K. and Bisht, Jaideep K. and Pattanayak, Arunava},
	keywords = {Researcher App},
}

@article{tortosa_copper_nodate,
	title = {Copper modulates nitrous oxide emissions from soybean root nodules},
	url = {https://www.sciencedirect.com/science/article/pii/S0098847220302884?dgcid=rss_sd_all&utm_source=researcher_app&utm_medium=referral&utm_campaign=RESR_MRKT_Researcher_inbound},
	doi = {10.1016/j.envexpbot.2020.104262},
	abstract = {{\textless}p{\textgreater}Agriculture is an important source of the greenhouse gas nitrous oxide (N$_{\textrm{2}}$O) due to the over- or non-synchronised application of nitrogen to crops. Symbiotic nitrogen fixation ({SNF}) by legume-rhizobia symbiosis can be an effective strategy for N$_{\textrm{2}}$O mitigation, but several environmental factors such as copper (Cu) availability might affect N$_{\textrm{2}}$O emissions derived from legume crops. The aim of this research was to study how Cu can modulate N$_{\textrm{2}}$O emissions by soybean root nodules. Soybean plants inoculated with {\textless}em{\textgreater}Bradyrhizobium diazoefficiens{\textless}/em{\textgreater} {USDA}110 were grown in the presence of 4 {mM} {KNO}$_{\textrm{3}}$ and a battery of Cu$^{\textrm{2+}}$ concentrations added during growth (0, 5, 10, 20, 40, 60 or 100 μM). N$_{\textrm{2}}$O emissions were measured by gas chromatography in both, nodulated roots and detached nodules, after root flooding. Also, $^{\textrm{15}}$N isotope dilution was assayed for {SNF} and N$_{\textrm{2}}$O determinations. Results showed that an excess of added Cu during growth significantly affected plant physiology, nodulation and {SNF} of the soybean-{\textless}em{\textgreater}B.diazoefficiens{\textless}/em{\textgreater} symbiosis, being 20 μM the threshold that soybean plants can tolerate without suffering Cu stress. Meanwhile, Cu addition reduced statistically N$_{\textrm{2}}$O emissions by soybean nodules. This reduction was correlated with Cu accumulation in nodules, which affected the denitrifying enzymes activities. Cu excess produced a simultaneous decrease of nitrate and nitrite reductase activities, but an increase of nitrous oxide reductase activity. Finally, the modulation of bacteroidal nitrate reductase activity is proposed as an effective target for the strategies for mitigation of N$_{\textrm{2}}$O emissions derived from soybean crops, probably more effective than nitrous oxide reductase activity.{\textless}/p{\textgreater}},
	journaltitle = {Environmental and Experimental Botany},
	author = {Tortosa, Germán and Pacheco, Pedro J. and Hidalgo-García, Alba and Granados, Arsenio and Delgado, Antonio and Mesa, Socorro and Bedmar, Eulogio J. and Delgado, María J.},
	keywords = {Researcher App},
}

