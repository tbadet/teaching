@article{hawker_roles_2004,
	title = {Roles for Class {III} {HD}-Zip and {KANADI} Genes in Arabidopsis Root Development},
	volume = {135},
	rights = {https://academic.oup.com/journals/pages/open\_access/funder\_policies/chorus/standard\_publication\_model},
