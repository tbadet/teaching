@article{jordan_thermal_1984,
	title = {Thermal and Water Relations of Roots of Desert Succulents},
	volume = {54},
	issn = {1095-8290, 0305-7364},
	url = {https://academic.oup.com/aob/article/144975/Thermal},
	doi = {10.1093/oxfordjournals.aob.a086840},
	series = {4.357},
	abstract = {Two succulent perennials from the Sonoran Desert, Agave deserti Engelm. and Ferocactus acanthodes (Lem.) Britton and Rose, lose little water through their roots during drought, yet respond rapidly to light rainfall. Their roots tend to be shallow, although absent from the upper 20 mm or so of the soil. During 12-15 d after a rainfall, new root production increased total root length by 47 per cent to 740 m for A. deserti and by 27 per cent to 230 m for F. acanthodes; root dry weight then averaged only 15 per cent of shoot dry weight. The annual carbon allocated to dry weight of new roots required 11 per cent of shoot carbon dioxide uptake for A. deserti and 19 per cent for F. acanthodes. Elongation of new roots was greatest near a soil temperature of 30 °C, and lethal temperature extremes (causing a 50 per cent decrease in root parenchyma cells taking up stain) were 56 °C and - 7 °C. Soil temperatures annually exceeded the measured tolerance to high temperature at depths less than 20 mm, probably explaining the lack of roots in this zone.},
	pages = {705--717},
	number = {5},
	journaltitle = {Annals of Botany},
	author = {Jordan, Peter W. and Nobel, Park S.},
	urldate = {2020-10-14},
	date = {1984-11},
	langid = {english},
	keywords = {root architecture🕸, heat stress 🔥, desert},
	file = {Jordan et Nobel - 1984 - Thermal and Water Relations of Roots of Desert Suc.pdf:/Users/cmaslard/Zotero/storage/P3IBN7Y3/Jordan et Nobel - 1984 - Thermal and Water Relations of Roots of Desert Suc.pdf:application/pdf},
}

