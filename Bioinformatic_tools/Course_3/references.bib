@article{wang_large_2018,
	title = {{LARGE} {ROOT} {ANGLE}1, encoding {OsPIN}2, is involved in root system architecture in rice},
	volume = {69},
	issn = {0022-0957},
	url = {https://doi.org/10.1093/jxb/erx427},
	doi = {10.1093/jxb/erx427},
	series = {6.992},
	abstract = {Root system architecture is very important for plant growth and crop yield. It is essential for nutrient and water uptake, anchoring, and mechanical support. Root growth angle ({RGA}) is a vital constituent of root system architecture and is used as a parameter for variety evaluation in plant breeding. However, little is known about the underlying molecular mechanisms that determine root growth angle in rice (Oryza sativa). In this study, a rice mutant large root angle1 (lra1) was isolated and shown to exhibit a large {RGA} and reduced sensitivity to gravity. Genome resequencing and complementation assays identified {OsPIN}2 as the gene responsible for the mutant phenotypes. {OsPIN}2 was mainly expressed in roots and the base of shoots, and showed polar localization in the plasma membrane of root epidermal and cortex cells. {OsPIN}2 was shown to play an important role in mediating root gravitropic responses in rice and was essential for plants to produce normal {RGAs}. Taken together, our findings suggest that {OsPIN}2 plays an important role in root gravitropic responses and determining the root system architecture in rice by affecting polar auxin transport in the root tip.},
	pages = {385--397},
	number = {3},
	journaltitle = {Journal of Experimental Botany},
	shortjournal = {Journal of Experimental Botany},
	author = {Wang, Lingling and Guo, Mengxue and Li, Yong and Ruan, Wenyuan and Mo, Xiaorong and Wu, Zhongchang and Sturrock, Craig J and Yu, Hao and Lu, Chungui and Peng, Jinrong and Mao, Chuanzao},
	urldate = {2023-01-24},
	date = {2018-01-23},
	keywords = {root architecture🕸, angle},
	file = {Snapshot:/Users/cmaslard/Zotero/storage/Y298HKMQ/4773865.html:text/html;Wang et al_2018_LARGE ROOT ANGLE1, encoding OsPIN2, is involved in root system architecture in.pdf:/Users/cmaslard/Zotero/storage/8T4Q6JFA/Wang et al_2018_LARGE ROOT ANGLE1, encoding OsPIN2, is involved in root system architecture in.pdf:application/pdf},
