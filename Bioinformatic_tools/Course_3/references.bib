	langid = {english},
	file = {Ozga et al. - 2016 - Hormonal regulation of reproductive growth under n.pdf:/Users/cmaslard/Zotero/storage/BILQSSEJ/Ozga et al. - 2016 - Hormonal regulation of reproductive growth under n.pdf:application/pdf},
}

@article{ul_haq_heat_2019,
	title = {Heat Shock Proteins: Dynamic Biomolecules to Counter Plant Biotic and Abiotic Stresses},
	volume = {20},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	issn = {1422-0067},
	url = {https://www.mdpi.com/1422-0067/20/21/5321},
	doi = {10.3390/ijms20215321},
	shorttitle = {Heat Shock Proteins},
	abstract = {Due to the present scenario of climate change, plants have to evolve strategies to survive and perform under a plethora of biotic and abiotic stresses, which restrict plant productivity. Maintenance of plant protein functional conformation and preventing non-native proteins from aggregation, which leads to metabolic disruption, are of prime importance. Plant heat shock proteins ({HSPs}), as chaperones, play a pivotal role in conferring biotic and abiotic stress tolerance. Moreover, {HSP} also enhances membrane stability and detoxiﬁes the reactive oxygen species ({ROS}) by positively regulating the antioxidant enzymes system. Additionally, it uses {ROS} as a signal to molecules to induce {HSP} production. {HSP} also enhances plant immunity by the accumulation and stability of pathogenesis-related ({PR}) proteins under various biotic stresses. Thus, to unravel the entire plant defense system, the role of {HSPs} are discussed with a special focus on plant response to biotic and abiotic stresses, which will be helpful in the development of stress tolerance in plant crops.},
	pages = {5321},
	number = {21},
	journaltitle = {International Journal of Molecular Sciences},
	shortjournal = {{IJMS}},
	author = {{Ul Haq} and {Khan} and {Ali} and {Khattak} and {Gai} and {Zhang} and {Wei} and {Gong}},
	urldate = {2024-06-19},
	date = {2019-10-25},
	langid = {english},
	file = {Ul Haq et al. - 2019 - Heat Shock Proteins Dynamic Biomolecules to Count.pdf:/Users/cmaslard/Zotero/storage/YPBZFLAX/Ul Haq et al. - 2019 - Heat Shock Proteins Dynamic Biomolecules to Count.pdf:application/pdf},
