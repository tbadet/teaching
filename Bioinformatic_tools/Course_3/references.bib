	langid = {english},
	note = {tex.ids= {JumraniInteractiveeffecttemperature}2019a, {jumraniInteractiveEffectTemperature}2019a},
	keywords = {soybean🌿, drought🚱, heat stress 🔥, metabolomic, physiology},
	file = {Jumrani et Bhatia - 2019 - Interactive effect of temperature and water stress.pdf:/Users/cmaslard/Zotero/storage/V7QDXJ6B/Jumrani et Bhatia - 2019 - Interactive effect of temperature and water stress.pdf:application/pdf;Jumrani et Bhatia - 2019 - Interactive effect of temperature and water stress.pdf:/Users/cmaslard/Zotero/storage/P5DNI3KY/Jumrani et Bhatia - 2019 - Interactive effect of temperature and water stress.pdf:application/pdf},
