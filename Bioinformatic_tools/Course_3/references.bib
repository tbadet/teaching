@article{chen_biological_2003,
	title = {Biological control of Delia radicum (Diptera: Anthomyiidae) with entomopathogenic nematodes},
	volume = {38},
	issn = {0003-6862, 1347-605X},
	url = {http://joi.jlc.jst.go.jp/JST.JSTAGE/aez/2003.441?from=CrossRef},
	doi = {10.1303/aez.2003.441},
	shorttitle = {Biological control of Delia radicum (Diptera},
	abstract = {Experiments evaluating the bio-control of the cabbage root maggot, Delia radicum, with entomopathogenic nematodes were conducted in the greenhouse and in the ﬁeld. In the greenhouse better control was obtained with Steinernema feltiae than with S. arenarium, S. carpocapsae, Heterorhabditis megidis, and H. bacteriophora. Increasing doses of S. feltiae improved insect control; the best results were obtained with applications of 4,000 or 8,000 infective juveniles per plant. Applying S. feltiae eight days earlier or eight days later than the inoculation of insect eggs or applying both at the same time did not give signiﬁcant differences in D. radicum control. Field control of D. radicum with S. feltiae was not successful in early spring but improved in summer. The number of surviving insects and the cabbage damage were signiﬁcantly reduced after applying S. feltiae in summer.},
	pages = {441--448},
	number = {4},
	journaltitle = {Applied Entomology and Zoology},
	author = {Chen, Shulong and Han, Xiuying and Moens, Maurice},
	urldate = {2019-04-24},
