	file = {Salt et al. - 2008 - Ionomics and the Study of the Plant Ionome.pdf:/Users/cmaslard/Zotero/storage/CG757K45/Salt et al. - 2008 - Ionomics and the Study of the Plant Ionome.pdf:application/pdf},
