	langid = {english},
	file = {Bulgarelli et al. - 2015 - Structure and Function of the Bacterial Root Micro.pdf:/Users/cmaslard/Zotero/storage/PG5JPKMT/Bulgarelli et al. - 2015 - Structure and Function of the Bacterial Root Micro.pdf:application/pdf},
}

