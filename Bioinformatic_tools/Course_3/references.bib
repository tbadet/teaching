@article{perianez-rodriguez_auxin-regulable_2021,
	title = {An auxin-regulable oscillatory circuit drives the root clock in \textit{Arabidopsis}},
	volume = {7},
	rights = {https://creativecommons.org/licenses/by-nc/4.0/},
	issn = {2375-2548},
	url = {https://www.science.org/doi/10.1126/sciadv.abd4722},
	doi = {10.1126/sciadv.abd4722},
	abstract = {The root clock oscillator is formed by auxin-responsive factors and auxin, allowing a dynamic response to external stimuli.
          , 
            
              In
              Arabidopsis
              , the root clock regulates the spacing of lateral organs along the primary root through oscillating gene expression. The core molecular mechanism that drives the root clock periodicity and how it is modified by exogenous cues such as auxin and gravity remain unknown. We identified the key elements of the oscillator ({AUXIN} {RESPONSE} {FACTOR} 7, its auxin-sensitive inhibitor {IAA}18/{POTENT}, and auxin) that form a negative regulatory loop circuit in the oscillation zone. Through multilevel computer modeling fitted to experimental data, we explain how gene expression oscillations coordinate with cell division and growth to create the periodic pattern of organ spacing. Furthermore, gravistimulation experiments based on the model predictions show that external auxin stimuli can lead to entrainment of the root clock. Our work demonstrates the mechanism underlying a robust biological clock and how it can respond to external stimuli.},
	pages = {eabd4722},
	number = {1},
	journaltitle = {Science Advances},
	shortjournal = {Sci. Adv.},
	author = {Perianez-Rodriguez, Juan and Rodriguez, Marcos and Marconi, Marco and Bustillo-Avendaño, Estefano and Wachsman, Guy and Sanchez-Corrionero, Alvaro and De Gernier, Hugues and Cabrera, Javier and Perez-Garcia, Pablo and Gude, Inmaculada and Saez, Angela and Serrano-Ron, Laura and Beeckman, Tom and Benfey, Philip N. and Rodríguez-Patón, Alfonso and Del Pozo, Juan Carlos and Wabnik, Krzysztof and Moreno-Risueno, Miguel A.},
	urldate = {2025-08-05},
	date = {2021-01},
	langid = {english},
