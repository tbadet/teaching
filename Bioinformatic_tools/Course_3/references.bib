	urldate = {2023-12-18},
	date = {2022-10-01},
	langid = {english},
	keywords = {soybean🌿, drought🚱, heat stress 🔥, metabolomic},
	file = {Vital et al. - 2022 - Metabolic, physiological and anatomical responses .pdf:/Users/cmaslard/Zotero/storage/MWVQIMMD/Vital et al. - 2022 - Metabolic, physiological and anatomical responses .pdf:application/pdf},
