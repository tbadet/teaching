@book{widehem_horticulture_2006,
	title = {L'horticulture ornementale française: Structures, acteurs et marchés},
	isbn = {978-2-7380-1207-4},
	shorttitle = {L'horticulture ornementale française},
	abstract = {Dans les pays industrialisés, le produit horticole d'ornement s'adresse principalement à deux types de clientèle : les particuliers pour l'environnement privé et les acteurs du monde du paysage pour les espaces publics et privés. Ces deux marchés sont globalement en croissance. En France, une concentration relativement rapide de l'aval de la production s'opère alors même que les " géants " de la distribution s'intéressent à ce marché. Quelle place sera réservée demain à la production horticole française ? Les Pays-Bas ont depuis longtemps mis en place des dispositifs d'encadrement technique et économique, des réseaux de commercialisation et mené des actions de promotion - autant dire une véritable politique au profit de l'horticulture ornementale. Optimiser la commercialisation des produits français est une étape obligatoire de l'évolution de l'horticulture française. {II} y a là un véritable enjeu politique et un défi à relever par les professionnels mais aussi par un engagement fort des pouvoirs publics. Résultat d'une approche commune de chercheurs de différentes disciplines et de la confrontation de leurs analyses avec celles de nombreux acteurs professionnels et institutionnels, cet ouvrage propose au lecteur une réflexion sur les enjeux actuels et futurs et ouvre le débat sur l'avenir de l'horticulture française},
	pagetotal = {112},
	publisher = {Editions Quae},
	author = {Widehem, Caroline and Cadic, Alain},
	date = {2006-02},
	langid = {french},
	note = {Google-Books-{ID}: s6y9tliOj68C},
	keywords = {Technology \& Engineering / Agriculture / Agronomy / Crop Science},
}

