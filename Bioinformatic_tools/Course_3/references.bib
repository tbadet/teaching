	title = {Dynamics of the Methanogenic Archaeal Community during Plant Residue Decomposition in an Anoxic Rice Field Soil},
	volume = {74},
	issn = {0099-2240, 1098-5336},
	url = {https://AEM.asm.org/content/74/9/2894},
