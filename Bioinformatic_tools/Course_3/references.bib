	file = {Peng et al. - 2013 - Bacterial communities predominant in the degradati.pdf:/Users/cmaslard/Zotero/storage/AMQ8UQSJ/Peng et al. - 2013 - Bacterial communities predominant in the degradati.pdf:application/pdf},
