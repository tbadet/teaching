	volume = {46},
	issn = {09819428},
	url = {http://linkinghub.elsevier.com/retrieve/pii/S0981942807002203},
	doi = {10.1016/j.plaphy.2007.10.022},
	abstract = {Plant vacuolar Naþ/Hþ antiporter plays an important role in salt tolerance. In order to understand the molecular basis of vacuolar Naþ/Hþ antiporter responded to salinity and reveal a possible role of salt tolerance in monocots, a vacuolar Naþ/Hþ antiporter gene ({AlNHX} ) was isolated by reverse transcription-{PCR} and {RNA} ligase mediated rapid ampliﬁcation of {cDNA} ends ({RLM}-{RACE}) based on the homology from Aeluropus littoralis (Gouan) Parl, a graminaceous halophyte. The {AlNHX} sequence contained 2706 bp with an open read frame of 1623 bp and the deduced transcripts encoding 540 amino acids shared a high homology with those putative vacuolar Naþ/Hþ antiporters of higher plants. {AlNHX} was predicted containing ten putative hydrophobic regions, which was different with {AtNHX}1 and {OsNHX}1. {DNA} gel blot analysis indicated that there were two or three copies of {AlNHX} in the A. littoralis genome. The increased transcript levels of {AlNHX} were much higher in roots than that in shoots under salt stress. In addition, overexpression of {AlNHX} in tobacco conferred high salt tolerance to the transgenic plants. The analysis of ion contents indicated that under high salt stress for one month, the transgenic plants compartmentalized more Naþ in the roots and kept a relative high Kþ/Naþ ratio in the leaves compared with wild-type plants.},
	pages = {117--126},
	number = {2},
	journaltitle = {Plant Physiology and Biochemistry},
	author = {Zhang, Gao-Hua and Su, Qiao and An, Li-Jia and Wu, Song},
	urldate = {2018-09-29},
	date = {2008-02},
	langid = {english},
	file = {Zhang et al_2008_Characterization and expression of a vacuolar Na+-H+ antiporter gene from the.PDF:/Users/cmaslard/Zotero/storage/DD3C66ZC/Zhang et al_2008_Characterization and expression of a vacuolar Na+-H+ antiporter gene from the.PDF:application/pdf;Zhang et al. - 2008 - Characterization and expression of a vacuolar Na+.PDF:/Users/cmaslard/Zotero/storage/3YPV7Z63/Zhang et al. - 2008 - Characterization and expression of a vacuolar Na+.PDF:application/pdf;Zhang et al. - 2008 - Characterization and expression of a vacuolar Na+.PDF:/Users/cmaslard/Zotero/storage/HZ7YHUA8/Zhang et al. - 2008 - Characterization and expression of a vacuolar Na+.PDF:application/pdf},
