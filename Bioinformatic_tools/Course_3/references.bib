	urldate = {2020-09-16},
	date = {2014-03-03},
	langid = {english},
	keywords = {a voir},
	file = {Saia et al. - 2014 - Influence of Arbuscular Mycorrhizae on Biomass Pro.pdf:/Users/cmaslard/Zotero/storage/JT8NA48V/Saia et al. - 2014 - Influence of Arbuscular Mycorrhizae on Biomass Pro.pdf:application/pdf},
