@article{burch-smith_plasmodesmata_2012,
	title = {Plasmodesmata Paradigm Shift: Regulation from Without Versus Within},
	volume = {63},
	issn = {1543-5008, 1545-2123},
	url = {https://www.annualreviews.org/doi/10.1146/annurev-arplant-042811-105453},
	doi = {10.1146/annurev-arplant-042811-105453},
	series = {26.379},
	shorttitle = {Plasmodesmata Paradigm Shift},
	abstract = {Plant cells are surrounded by cellulosic cell walls, creating a potential challenge to resource sharing and information exchange between individual cells. To overcome this, plants have evolved channels called plasmodesmata that provide cytoplasmic continuity between each cell and its immediate neighbors. We ﬁrst review plasmodesmata basics—their architecture, their origin, the types of cargo they transport, and their molecular components. The bulk of this review discusses the regulation of plasmodesmata formation and function. Historically, plasmodesmata research has focused intensely on uncovering regulatory or structural proteins that reside within or immediately adjacent to plasmodesmata. Recent ﬁndings, however, underscore that plasmodesmata are exquisitely sensitive to signals far removed from the plasmodesmal channel itself. Signals originating from molecules and pathways that regulate cellular homeostasis—such as reactive oxygen species, organelle-organelle signaling, and organelle-nucleus signaling—lead to astonishing alterations in gene expression that affect plasmodesmata formation and function.},
	pages = {239--260},
	number = {1},
	journaltitle = {Annual Review of Plant Biology},
	shortjournal = {Annu. Rev. Plant Biol.},
	author = {Burch-Smith, Tessa M. and Zambryski, Patricia C.},
	urldate = {2024-06-11},
	date = {2012-06-02},
	langid = {english},
	file = {Burch-Smith et Zambryski - 2012 - Plasmodesmata Paradigm Shift Regulation from With.pdf:/Users/cmaslard/Zotero/storage/IGVZD5PH/Burch-Smith et Zambryski - 2012 - Plasmodesmata Paradigm Shift Regulation from With.pdf:application/pdf},
}

