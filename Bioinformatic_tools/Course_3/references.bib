	langid = {english},
	keywords = {microbial communities🦠},
	file = {Huet et al. - 2023 - Experimental community coalescence sheds light on .pdf:/Users/cmaslard/Zotero/storage/DNG38YFW/Huet et al. - 2023 - Experimental community coalescence sheds light on .pdf:application/pdf},
}

