	langid = {english},
	file = {Zandalinas et al. - 2016 - ABA is required for the accumulation of APX1 and M.pdf:/Users/cmaslard/Zotero/storage/QMT3UM6S/Zandalinas et al. - 2016 - ABA is required for the accumulation of APX1 and M.pdf:application/pdf},
}

