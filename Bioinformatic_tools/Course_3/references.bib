@article{galindo-castaneda_location_2024,
	title = {Location: root architecture structures rhizosphere microbial associations},
	volume = {75},
	issn = {0022-0957, 1460-2431},
	url = {https://academic.oup.com/jxb/article/75/2/594/7330382},
	doi = {10.1093/jxb/erad421},
	series = {6.992},
	shorttitle = {Location},
	abstract = {Root architectural phenotypes are promising targets for crop breeding, but root architectural effects on microbial associations in agricultural fields are not well understood. Architecture determines the location of microbial associations within root systems, which, when integrated with soil vertical gradients, determines the functions and the metabolic capability of rhizosphere microbial communities. We argue that variation in root architecture in crops has important implications for root exudation, microbial recruitment and function, and the decomposition and fate of root tissues and exudates. Recent research has shown that the root microbiome changes along root axes and among root classes, that root tips have a unique microbiome, and that root exudates change within the root system depending on soil physicochemical conditions. Although fresh exudates are produced in larger amounts in root tips, the rhizosphere of mature root segments also plays a role in influencing soil vertical gradients. We argue that more research is needed to understand specific root phenotypes that structure microbial associations and discuss candidate root phenotypes that may determine the location of microbial hotspots within root systems with relevance to agricultural systems.},
	pages = {594--604},
	number = {2},
	journaltitle = {Journal of Experimental Botany},
	author = {Galindo-Castañeda, Tania and Hartmann, Martin and Lynch, Jonathan P},
	editor = {Gifford, Miriam},
	urldate = {2024-03-13},
	date = {2024-01-10},
	langid = {english},
	keywords = {root architecture🕸, microbial communities🦠},
	file = {Galindo-Castañeda et al. - 2024 - Location root architecture structures rhizosphere.pdf:/Users/cmaslard/Zotero/storage/YE3Z7X28/Galindo-Castañeda et al. - 2024 - Location root architecture structures rhizosphere.pdf:application/pdf},
}

@article{pervaiz_root_2020,
	title = {Root microbiome changes with root branching order and root chemistry in peach rhizosphere soil},
	volume = {16},
	issn = {24522198},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2452219820301610},
	doi = {10.1016/j.rhisph.2020.100249},
	series = {3.129},
	abstract = {The plant root system influences plant growth and development due to its phenotypic, physiological, metab­ olomic, and microbiomic traits. Broadly speaking, it is characterized by primary (stem-attached large), secondary (primary-attached medium), and fine (secondary-attached hair-like) roots. The role of root branching order and categories (fine, medium, and large) in influencing microbial communities in the rhizosphere and root envi­ ronments is not clear. We studied whether and how different root categories influence the composition of root and rhizosphere microbial communities in young peach trees. Using next-generation 16S {rRNA} amplicon sequencing (V3–V4 region), we profiled the microbial communities of roots and rhizosphere environments from phylum to species-level taxonomies. We demonstrated that different root categories showed a unique microbial community composition. Interestingly, fine or small roots recruited more diverse and species-rich microbial communities, very likely due to their better mineral contents (e.g., Mo, Fe, Mn, S, Zn, Cu, K, and P) and exposure with soil, though more research is needed to establish these relationships. Small roots and their rhizosphere environments showed a higher abundance of important bacterial taxa (e.g., Bradyrhizobium, Pseudomonas, Streptomyces, Burkholderia, Sphingomonas) that are previously known to play important roles in soil disease suppressiveness, plant growth, nutrient fixation, solubilization, and cycling. We suggest that linking microbial communities and their functions to root branching order and categories may enhance our understanding of rhizospheric interactions, soil disease suppressiveness, and their role in tree fruit performance.},
	pages = {100249},
	journaltitle = {Rhizosphere},
	shortjournal = {Rhizosphere},
	author = {Pervaiz, Zahida H. and Contreras, Janet and Hupp, Brody M. and Lindenberger, Josh H. and Chen, Dima and Zhang, Qingming and Wang, Caixia and Twigg, Paul and Saleem, Muhammad},
	urldate = {2024-01-12},
	date = {2020-12},
	langid = {english},
	keywords = {root architecture🕸, microbial communities🦠},
	file = {Pervaiz et al. - 2020 - Root microbiome changes with root branching order .pdf:/Users/cmaslard/Zotero/storage/TLTGYSV7/Pervaiz et al. - 2020 - Root microbiome changes with root branching order .pdf:application/pdf},
}

