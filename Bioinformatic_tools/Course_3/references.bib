	date = {2017-08-24},
	langid = {english},
	file = {PDF:/Users/cmaslard/Zotero/storage/DUYTBY5D/Helms et al. - 2017 - Identification of an insect-produced olfactory cue that primes plant defenses.pdf:application/pdf},
}

@article{heidstra_mosaic_2004,
