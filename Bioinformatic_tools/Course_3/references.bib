	file = {Reddy et al. - 2004 - Drought-induced responses of photosynthesis and an.pdf:/Users/cmaslard/Zotero/storage/I6ZZBERM/Reddy et al. - 2004 - Drought-induced responses of photosynthesis and an.pdf:application/pdf},
}

