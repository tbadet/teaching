@article{brady_high-resolution_2007,
	title = {A High-Resolution Root Spatiotemporal Map Reveals Dominant Expression Patterns},
	volume = {318},
	issn = {0036-8075, 1095-9203},
	url = {https://www.science.org/doi/10.1126/science.1146265},
	doi = {10.1126/science.1146265},
	abstract = {Transcriptional programs that regulate development are exquisitely controlled in space and time. Elucidating these programs that underlie development is essential to understanding the acquisition of cell and tissue identity. We present microarray expression profiles of a high-resolution set of developmental time points within a single
              Arabidopsis
              root and a comprehensive map of nearly all root cell types. These cell type–specific transcriptional signatures often predict previously unknown cellular functions. A computational pipeline identified dominant expression patterns that demonstrate transcriptional similarity between disparate cell types. Dominant expression patterns along the root's longitudinal axis do not strictly correlate with previously defined developmental zones, and in many cases, we observed expression fluctuation along this axis. Both robust co-regulation of gene expression and potential phasing of gene expression were identified between individual roots. Methods that combine these profiles demonstrate transcriptionally rich and complex programs that define
              Arabidopsis
              root development in both space and time.},
	pages = {801--806},
	number = {5851},
	journaltitle = {Science},
	shortjournal = {Science},
	author = {Brady, Siobhan M. and Orlando, David A. and Lee, Ji-Young and Wang, Jean Y. and Koch, Jeremy and Dinneny, José R. and Mace, Daniel and Ohler, Uwe and Benfey, Philip N.},
	urldate = {2025-08-05},
	date = {2007-11-02},
	langid = {english},
	file = {PDF:/Users/cmaslard/Zotero/storage/JAMU3DJA/Brady et al. - 2007 - A High-Resolution Root Spatiotemporal Map Reveals Dominant Expression Patterns.pdf:application/pdf;PDF:/Users/cmaslard/Zotero/storage/444BNH8X/Brady et al. - 2007 - A High-Resolution Root Spatiotemporal Map Reveals Dominant Expression Patterns.pdf:application/pdf},
}

@article{bourque_ten_2018,
	title = {Ten things you should know about transposable elements},
