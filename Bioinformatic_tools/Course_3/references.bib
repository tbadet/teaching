@article{flores-renteria_soil_2018,
	title = {Soil legacies determine the resistance of an experimental plant-soil system to drought},
	volume = {166},
	issn = {03418162},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0341816218301267},
	doi = {10.1016/j.catena.2018.04.011},
	series = {5.198},
	abstract = {This study examines the eﬀects of climate and the degree of forest fragmentation legacies on response of oak to drought. A microcosm approach was set up with holm oak seedlings from three provenances grown in soils coming from two regions of contrasting climate (drier vs. wetter), and three scenarios of forest fragmentation (low, mid, and high agricultural matrix inﬂuence). We measured diﬀerent indicators of the plant-soil system functioning such as ecosystem respiration, net ecosystem exchange, gross primary productivity, stomatal conductance, quantum yield, biomass allocation, and mycorrhization. Legacies of the bioclimatic region and the degree of forest fragmentation on soil properties drove the response to drought of an experimental plant-soil system, masking the eﬀects of seedling provenance. The system was functionally more resistant to drought in soils from forest fragments with more agricultural inﬂuence and from the drier region. Our results indicate that the degree of forest fragmentation and bioclimatic legacies on soil properties exerted a much more decisive eﬀect on the response of the plant-soil system to drought than holm-oak seedling provenance.},
	pages = {271--278},
	journaltitle = {{CATENA}},
	shortjournal = {{CATENA}},
	author = {Flores-Rentería, Dulce and Curiel Yuste, Jorge and Valladares, Fernando and Rincón, Ana},
	urldate = {2020-06-26},
