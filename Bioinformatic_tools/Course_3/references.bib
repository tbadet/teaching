@article{rosas_integration_2013,
	title = {Integration of responses within and across \textit{Arabidopsis} natural accessions uncovers loci controlling root systems architecture},
	volume = {110},
	issn = {0027-8424, 1091-6490},
	url = {https://pnas.org/doi/full/10.1073/pnas.1305883110},
	doi = {10.1073/pnas.1305883110},
	abstract = {Significance
            
              Species display a range of plastic phenotypes that presumably have evolved as a result of adaptation to heterogeneous environments. We asked whether the genetic mechanisms that underlie adaptation across populations also determine the response of an individual plant to environmental cues in
              Arabidopsis
              . Using an integrative root phenotyping approach, genes that underlie natural variation in root architecture across populations were shown to control plasticity responses within an individual. Together, our results uncover a genetic mechanism underlying the phenotypic plasticity of an individual and phenotypic diversity across natural variants.
            
          , 
            
              Phenotypic plasticity is presumed to be involved in adaptive change toward species diversification. We thus examined how candidate genes underlying natural variation across populations might also mediate plasticity within an individual. Our implementation of an integrative “plasticity space” approach revealed that the root plasticity of a single
              Arabidopsis
              accession exposed to distinct environments broadly recapitulates the natural variation “space.” Genome-wide association mapping identified the known gene
              {PHOSPHATE} 1
              (
              {PHO}1
              ) and other genes such as
              Root System Architecture 1
              (
              {RSA}1
              ) associated with differences in root allometry, a highly plastic trait capturing the distribution of lateral roots along the primary axis. The response of mutants in the Columbia-0 background suggests their involvement in signaling key modulators of root development including auxin, abscisic acid, and nitrate. Moreover, genotype-by-environment interactions for the
              {PHO}1
              and
              {RSA}1
              genes in Columbia-0 phenocopy the root allometry of other natural variants. This finding supports a role for plasticity responses in phenotypic evolution in natural environments.},
	pages = {15133--15138},
	number = {37},
	journaltitle = {Proceedings of the National Academy of Sciences},
	shortjournal = {Proc. Natl. Acad. Sci. U.S.A.},
	author = {Rosas, Ulises and Cibrian-Jaramillo, Angelica and Ristova, Daniela and Banta, Joshua A. and Gifford, Miriam L. and Fan, Angela Huihui and Zhou, Royce W. and Kim, Grace Jaeyoon and Krouk, Gabriel and Birnbaum, Kenneth D. and Purugganan, Michael D. and Coruzzi, Gloria M.},
	urldate = {2024-06-23},
	date = {2013-09-10},
	langid = {english},
	file = {Texte intégral:/Users/cmaslard/Zotero/storage/H8US9UGV/Rosas et al. - 2013 - Integration of responses within and across Arab.pdf:application/pdf},
}

