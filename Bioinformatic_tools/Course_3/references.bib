}

@unpublished{shen_timing_2023,
	title = {Timing of root barriers controls soil-to-shoot integration of rhizosphere status},
	abstract = {In roots, formation of the Casparian strip in the endodermal cell walls provides a means for selective solute movement by blocking apoplastic flow. This is under spatial surveillance by a receptor-ligand system termed the Schengen pathway. However, the physiological purpose of this is not clear, particularly under natural conditions. To address this, we created plants with an earlier onset of Casparian strips uncoupling barrier formation from the Schengen pathway. Within a complex growth setup, we find that this has severe consequences for a healthy microbiota and nitrogen-induced shoot growth, which provides insights into how root barriers integrate rhizosphere status. This creates a need for an updated nutrient use model that includes root barrier timing as an important factor for coordinating responses between above- and belowground tissues. made available under {aCC}-{BY}-{NC}-{ND} 4.0 International license.},
	author = {Shen, Defeng and Wippel, Kathrin and Remmel, Simone and Zhang, Pengfan and Kuertoes, Noah and Neumann, Ulla and Kopriva, Stanislav and Andersen, Tonni Grube},
	date = {2023},
