	langid = {english},
	file = {Rosa et al. - 2018 - RNA Interference Mechanisms and Applications in Pl.pdf:/Users/cmaslard/Zotero/storage/Z5N6TUTN/Rosa et al. - 2018 - RNA Interference Mechanisms and Applications in Pl.pdf:application/pdf},
}

