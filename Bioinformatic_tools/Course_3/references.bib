@article{shabala_turgor_2002,
	title = {Turgor Regulation in Osmotically Stressed Arabidopsis Epidermal Root Cells. Direct Support for the Role of Inorganic Ion Uptake as Revealed by Concurrent Flux and Cell Turgor Measurements},
	volume = {129},
	issn = {1532-2548, 0032-0889},
	url = {https://academic.oup.com/plphys/article/129/1/290/6110227},
	doi = {10.1104/pp.020005},
	series = {8.34},
	abstract = {Abstract
            Hyperosmotic stress is known to significantly enhance net uptake of inorganic ions into plant cells. Direct evidence for cell turgor recovery via such a mechanism, however, is still lacking. In the present study, we performed concurrent measurements of net ion fluxes (with the noninvasive microelectrode ion flux estimation technique) and cell turgor changes (with the pressure-probe technique) to provide direct evidence that inorganic ion uptake regulates turgor in osmotically stressed Arabidopsis epidermal root cells. Immediately after onset of hyperosmotic stress (100/100 mmmannitol/sorbitol treatment), the cell turgor dropped from 0.65 to about 0.25 {MPa}. Turgor recovery started within 2 to 10 min after the treatment and was accompanied by a significant (30–80 nmol m−2 s−1) increase in uptake of K+, Cl−, and Na+ by root cells. In most cells, almost complete (\&gt;90\% of initial values) recovery of the cell turgor was observed within 40 to 50 min after stress onset. In another set of experiments, we combined the voltage-clamp and the microelectrode ion flux estimation techniques to show that this process is, in part, mediated by voltage-gated K+ transporters at the cell plasma membrane. The possible physiological significance of these findings is discussed.},
	pages = {290--299},
	number = {1},
	journaltitle = {Plant Physiology},
	author = {Shabala, Sergey N. and Lew, Roger R.},
	urldate = {2024-03-06},
	date = {2002-05-01},
	langid = {english},
	file = {Shabala et Lew - 2002 - Turgor Regulation in Osmotically Stressed Arabidop.pdf:/Users/cmaslard/Zotero/storage/4MGMPVEI/Shabala et Lew - 2002 - Turgor Regulation in Osmotically Stressed Arabidop.pdf:application/pdf},
}

@article{plett_intersection_2020,
