	note = {\_eprint: https://nph.onlinelibrary.wiley.com/doi/pdf/10.1111/nph.19153},
	keywords = {review, cellular responses to stimuli, developmental cell trajectories, plant cell identity, regulatory networks, single-cell genomics, spatial transcriptomics},
	file = {Full Text PDF:/Users/cmaslard/Zotero/storage/E9XIFSYP/Oliva et Lister - 2023 - Exploring the identity of individual plant cells in space and time.pdf:application/pdf;Snapshot:/Users/cmaslard/Zotero/storage/GZPF39IT/nph.html:text/html},
