@article{rottmann_protoplast-esculin_nodate,
	title = {Protoplast-Esculin Assay as a New Method to Assay Plant Sucrose Transporters: Characterization of {AtSUC}6 and {AtSUC}7 Sucrose Uptake Activity in Arabidopsis Col-0 Ecotype.},
	url = {http://doi.org/10.3389/fpls.2018.00430},
	doi = {10.3389/fpls.2018.00430},
	abstract = {The best characterized function of sucrose transporters of the {SUC} family in plants is the uptake of sucrose into the phloem for long-distance transport of photoassimilates. This important step is usually performed by one specific {SUC} in every species. However, plants possess small families of several different {SUCs} which are less well understood. Here, we report on the characterization of {AtSUC}6 and {AtSUC}7, two members of the {SUC} family in \textit{Arabidopsis thaliana}. Heterologous expression in yeast (\textit{Saccharomyces cerevisiae}) revealed that {AtSUC}6$_{\textrm{Col-0}}$ is a high-affinity H$^{\textrm{+}}$-symporter that mediates the uptake of sucrose and maltose across the plasma membrane at exceptionally low {pH} values. Reporter gene analyses revealed a strong expression of \textit{{AtSUC}6}$_{\textrm{Col-0}}$ in reproductive tissues, where the protein product might contribute to sugar uptake into pollen tubes and synergid cells. A knockout of \textit{{AtSUC}6} did not interfere with vegetative development or reproduction, which points toward physiological redundancy of {AtSUC}6$_{\textrm{Col-0}}$ with other sugar transporters. Reporter gene analyses showed that \textit{{AtSUC}7}$_{\textrm{Col-0}}$ is expressed in roots and pollen tubes and that this sink specific expression of \textit{{AtSUC}7}$_{\textrm{Col-0}}$ is regulated by intragenic regions. Transport activity of {AtSUC}7$_{\textrm{Col-0}}$ could not be analyzed in baker's yeast or \textit{Xenopus} oocytes because the protein was not correctly targeted to the plasma membrane in both heterologous expression systems. Therefore, a novel approach to analyze sucrose transporters \textit{in planta} was developed. Plasma membrane localized {SUCs} including {AtSUC}6$_{\textrm{Col-0}}$ and also sucrose specific {SWEETs} were able to mediate transport of the fluorescent sucrose analog esculin in transformed mesophyll protoplasts. In contrast, {AtSUC}7$_{\textrm{Col-0}}$ is not able to mediate esculin transport across the plasma membrane which implicates that \textit{{AtSUC}7}$_{\textrm{Col-0}}$ might be a non-functional pseudogene. The novel protoplast assay provides a useful tool for the quick and quantitative analysis of sucrose transporters in an \textit{in planta} expression system.},
	journaltitle = {Frontiers in Plant Science},
	author = {Rottmann, Theresa M and Fritz, Carolin and Lauter, Anja and Schneider, Sabine and Fischer, Cornelia and Danzberger, Nina and Dietrich, Petra and Sauer, Norbert and Stadler, Ruth},
	keywords = {Researcher App},
}

@article{breia_vvsweet7_nodate,
	title = {{VvSWEET}7 Is a Mono- and Disaccharide Transporter Up-Regulated in Response to Botrytis cinerea Infection in Grape Berries},
	url = {https://www.frontiersin.org/articles/10.3389/fpls.2019.01753?utm_source=researcher_app&utm_medium=referral&utm_campaign=RESR_MRKT_Researcher_inbound},
	doi = {10.3389/fpls.2019.01753},
	abstract = {The newly-identified {SWEETs} are high-capacity, low-affinity sugar transporters with important roles in numerous physiological mechanisms where sugar efflux is critical. {SWEETs} are desirable targets for manipulation by pathogens and their expression may be transcriptionally reprogrammed during infection. So far, few plant {SWEET} transporters have been functionally characterized, especially in grapevine. In this study, in the \textit{Botrytis}-susceptible variety "Trincadeira," we thoroughly analyzed modifications in the gene expression profile of key \textit{{SWEET}} genes in \textit{Botrytis cinerea}-infected grape berries. {VvSWEET}7 and {VvSWEET}15 are likely to play an important role during fruit development and \textit{Botrytis} infection as they are strongly expressed at the green and mature stage, respectively, and were clearly up-regulated in response to infection. Also, \textit{B. cinerea} infection down-regulated \textit{{VvSWEET}17a} expression at the green stage, \textit{{VvSWEET}10} and \textit{{VvSWEET}17d} expression at the veraison stage, and \textit{{VvSWEET}11} expression at the mature stage. {VvSWEET}7 was functionally characterized by heterologous expression in \textit{Saccharomyces cerevisiae} as a low-affinity, high-capacity glucose and sucrose transporter with a \textit{K}$_{\textrm{m}}$ of 15.42 {mM} for glucose and a \textit{K}$_{\textrm{m}}$ of 40.08 {mM} for sucrose. {VvSWEET}7-{GFP} and {VvSWEET}15-{GFP} fusion proteins were transiently expressed in \textit{Nicotiana benthamiana} epidermal cells and confocal microscopy allowed to observe that both proteins clearly localize to the plasma membrane. In sum, {VvSWEETs} transporters are important players in sugar mobilization during grape berry development and their expression is transcriptionally reprogrammed in response to \textit{Botrytis} infection.},
	journaltitle = {Frontiers in Plant Science},
	author = {Breia, Richard and Conde, Artur and Pimentel, Diana and Conde, Carlos and Fortes, Ana Margarida and Granell, Antonio and Gerós, Hernâni},
	keywords = {Researcher App},
}

