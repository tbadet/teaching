@article{blaxter_evolution_2015,
	title = {The evolution of parasitism in Nematoda},
	volume = {142},
	issn = {0031-1820, 1469-8161},
	url = {https://www.cambridge.org/core/product/identifier/S0031182014000791/type/journal_article},
	doi = {10.1017/S0031182014000791},
	abstract = {Nematodes are abundant and diverse, and include many parasitic species. Molecular phylogenetic analyses have shown that parasitism of plants and animals has arisen at least 15 times independently. Extant nematode species also display lifestyles that are proposed to be on the evolutionary trajectory to parasitism. Recent advances have permitted the determination of the genomes and transcriptomes of many nematode species. These new data can be used to further resolve the phylogeny of Nematoda, and identify possible genetic patterns associated with parasitism. Plant-parasitic nematode genomes show evidence of horizontal gene transfer from other members of the rhizosphere, and these genes play important roles in the parasite-host interface. Similar horizontal transfer is not evident in animal parasitic groups. Many nematodes have bacterial symbionts that can be essential for survival. Horizontal transfer from symbionts to the nematode is also common, but its biological importance is unclear. Over 100 nematode species are currently targeted for sequencing, and these data will yield important insights into the biology and evolutionary history of parasitism. It is important that these new technologies are also applied to free-living taxa, so that the pre-parasitic ground state can be inferred, and the novelties associated with parasitism isolated.},
	pages = {S26--S39},
	issue = {S1},
	journaltitle = {Parasitology},
	author = {Blaxter, Mark and Koutsovoulos, Georgios},
	urldate = {2019-05-23},
	date = {2015-02},
	langid = {english},
	keywords = {philogenie, lue},
	file = {Blaxter et Koutsovoulos - 2015 - The evolution of parasitism in Nematoda.pdf:/Users/cmaslard/Zotero/storage/A5XA4GIC/Blaxter et Koutsovoulos - 2015 - The evolution of parasitism in Nematoda.pdf:application/pdf;Blaxter et Koutsovoulos - 2015 - The evolution of parasitism in Nematoda.pdf:/Users/cmaslard/Zotero/storage/2GW52KGI/Blaxter et Koutsovoulos - 2015 - The evolution of parasitism in Nematoda.pdf:application/pdf;Blaxter_Koutsovoulos_2015_The evolution of parasitism in Nematoda.pdf:/Users/cmaslard/Zotero/storage/FFXM6QY4/Blaxter_Koutsovoulos_2015_The evolution of parasitism in Nematoda.pdf:application/pdf},
}

@article{blaxter_genomics_2012,
	title = {Genomics and transcriptomics across the diversity of the Nematoda: Nematode Genomics},
	volume = {34},
	issn = {01419838},
	url = {http://doi.wiley.com/10.1111/j.1365-3024.2011.01342.x},
	doi = {10.1111/j.1365-3024.2011.01342.x},
	shorttitle = {Genomics and transcriptomics across the diversity of the Nematoda},
	abstract = {The diversity of biology in nematodes is reflected in the diversity of their genomes. Parasitic species in particular have evolved mechanisms to invade and outwit their hosts, and these offer opportunities for the development of control measures. Genomic analyses can reveal the molecular underpinnings of phenotypes such as parasitism and thus, initiate and support research programmes that explore the manipulation of host and parasite physiologies to achieve favourable outcomes. Wide sampling across nematode diversity allows phylogenetically informed formulation of research hypotheses, identification of core features shared by all species or important evolutionary novelties present in isolated clades. Many nematode species have been investigated through the use of the expressed sequence tag approach, which samples from the transcribed genome. Gene catalogues generated in this way can be explored to reveal the patterns of expression associated with parasitism and candidates for testing as drug targets or vaccine components. Analysis environments, such as {NEMBASE} facilitate exploitation of these data. The development of new high-throughput {DNA}-sequencing technologies has facilitated transcriptomic and genomic approaches to parasite biology. Whole genome sequencing offers more complete catalogues of genes and assists a systems approach to phenotype dissection. These efforts are being coordinated through the 959 Nematode Genomes initiative.},
	pages = {108--120},
	number = {2},
	journaltitle = {Parasite Immunology},
	author = {Blaxter, M. and Kumar, S. and Kaur, G. and Koutsovoulos, G. and Elsworth, B.},
	urldate = {2019-05-23},
	date = {2012-02},
	langid = {english},
	keywords = {gene, philogenie, lue},
	file = {Blaxter et al_2012_Genomics and transcriptomics across the diversity of the Nematoda.pdf:/Users/cmaslard/Zotero/storage/7AQRTTAI/Blaxter et al_2012_Genomics and transcriptomics across the diversity of the Nematoda.pdf:application/pdf;Blaxter et al. - 2012 - Genomics and transcriptomics across the diversity .pdf:/Users/cmaslard/Zotero/storage/YZ4QQWPA/Blaxter et al. - 2012 - Genomics and transcriptomics across the diversity .pdf:application/pdf;Blaxter et al. - 2012 - Genomics and transcriptomics across the diversity .pdf:/Users/cmaslard/Zotero/storage/LZJQ43VQ/Blaxter et al. - 2012 - Genomics and transcriptomics across the diversity .pdf:application/pdf},
