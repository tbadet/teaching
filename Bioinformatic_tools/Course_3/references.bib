@article{heve_biological_2017,
	title = {Biological control potential of entomopathogenic nematodes for management of Caribbean fruit fly, \textit{Anastrepha suspensa} Loew (Tephritidae): Can entomopathogenic nematodes contribute to Caribbean fruit fly {IPM}?},
	volume = {73},
	issn = {1526498X},
	url = {http://doi.wiley.com/10.1002/ps.4447},
	doi = {10.1002/ps.4447},
	shorttitle = {Biological control potential of entomopathogenic nematodes for management of Caribbean fruit fly, \textit{Anastrepha suspensa} Loew (Tephritidae)},
	abstract = {{BACKGROUND}: Caribbean fruit fly (Caribfly) is a serious economic insect pest because of development of larvae that hatch from eggs oviposited into fruits by female adults. This study assessed virulence of at least 10 entomopathogenic nematodes ({EPNs}) to Caribfly in laboratory bioassays as a starting point toward evaluation of management strategies for the fruit-to-soil-dwelling stages of A. suspensa in fields infested by Caribfly.
{RESULTS}: Inoculation of A. suspensa with 1 ml of ca. 200 {IJs} (larva)-1 killed Caribfly at either larval or pupal stage. Pupae were more resistant to {EPN} infections than larvae. Adult emergence from inoculated pupae in soil microcosms was significantly lower than those observed in filter paper assays. Longest or largest steinernematids suppressed emergence of more adult Caribfly from pupae in soils whereas shorter heterorhabditids were more infectious to Caribfly larvae. The highest mortalities of A. suspensa were caused by exotic nematodes Steinernema feltiae and Heterorhabditis bacteriophora followed by the native Heterorhabditis indica and the exotic Steinernema carpocapsae.
{CONCLUSION}: Entomopathogenic nematodes reduced development of Caribfly larvae and pupae to adult in our bioassays, suggesting that {EPNs} have potential for biological control of A. suspensa. Future work will assess management strategies, using the virulent {EPNs}, in orchards infested by A. suspensa.},
	pages = {1220--1228},
	number = {6},
	journaltitle = {Pest Management Science},
	author = {Heve, William K and El-Borai, Fahiem E and Carrillo, Daniel and Duncan, Larry W},
	urldate = {2019-04-23},
	date = {2017-06},
	langid = {english},
	keywords = {steinernema feltiae},
	file = {Heve et al_2017_Biological control potential of entomopathogenic nematodes for management of.pdf:/Users/cmaslard/Zotero/storage/KCAMA66B/Heve et al_2017_Biological control potential of entomopathogenic nematodes for management of.pdf:application/pdf;Heve et al. - 2017 - Biological control potential of entomopathogenic n.pdf:/Users/cmaslard/Zotero/storage/UNSZLADU/Heve et al. - 2017 - Biological control potential of entomopathogenic n.pdf:application/pdf;Heve et al. - 2017 - Biological control potential of entomopathogenic n.pdf:/Users/cmaslard/Zotero/storage/KS3LAR7F/Heve et al. - 2017 - Biological control potential of entomopathogenic n.pdf:application/pdf},
}

@article{mastore_susceptibility_2019,
	title = {Susceptibility to entomopathogens and modulation of basal immunity in two insect models at different temperatures},
	volume = {79},
	issn = {03064565},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0306456518302420},
	doi = {10.1016/j.jtherbio.2018.11.006},
	abstract = {In this work, we analysed the efficacy of different commercial bio-insecticides (Steinernema feltiae, Steinernema carpocapsae, Heterorhabditis bacteriophora and Bacillus thuringiensis) by valuating the mortality induced on two insect models, Galleria mellonella (Lepidoptera) and Sarcophaga africa (Diptera) after exposure to different temperatures (10, 20 and 30 °C). Moreover, we investigated the effects of temperature on the basal humoral immunity of the two target insects; particularly, phenoloxidase ({PO}) and lysozyme activity. Our results show that G. mellonella is susceptible to all bio-insecticides at all the examined temperatures, except when infected at 10 °C with S. carpocapsae and at 30 °C with S. feltiae and B. thuringiensis. S. africa is more susceptible at 30 °C to all bioinsecticides; whereas, when infected at 10 and 20 °C, H. bacteriophora is the most efficient. Temperature modulates {PO} activity of both G. mellonella and S. africa, otherwise variations in lysozyme activity is observed only in G. mellonella. Except for a possible correlation between the increased lysozyme activity and the delayed Bt efficacy recorded on G. mellonella at 30 °C, a different resistance to bio-insecticides at different temperatures does not seem to be associated to variations of the host basal immunity, probably due to immunoevasive and immunodepressive strategies of these entomopathogens.},
	pages = {15--23},
	journaltitle = {Journal of Thermal Biology},
	author = {Mastore, Maristella and Quadroni, Silvia and Toscano, Andrea and Mottadelli, Nicolò and Brivio, Maurizio F.},
	urldate = {2019-04-23},
	date = {2019-01},
	langid = {english},
	keywords = {steinernema feltiae},
	file = {Mastore et al_2019_Susceptibility to entomopathogens and modulation of basal immunity in two.pdf:/Users/cmaslard/Zotero/storage/LUZES5Q2/Mastore et al_2019_Susceptibility to entomopathogens and modulation of basal immunity in two.pdf:application/pdf;Mastore et al. - 2019 - Susceptibility to entomopathogens and modulation o.pdf:/Users/cmaslard/Zotero/storage/2AIJCX9P/Mastore et al. - 2019 - Susceptibility to entomopathogens and modulation o.pdf:application/pdf;Mastore et al. - 2019 - Susceptibility to entomopathogens and modulation o.pdf:/Users/cmaslard/Zotero/storage/EGE8MEER/Mastore et al. - 2019 - Susceptibility to entomopathogens and modulation o.pdf:application/pdf},
}

@article{laznik_attraction_2016,
	title = {Attraction Behaviors of Entomopathogenic Nematodes (Steinernematidae and Heterorhabditidae) to Synthetic Volatiles Emitted by Insect Damaged Potato Tubers},
	volume = {42},
	issn = {0098-0331, 1573-1561},
	url = {http://link.springer.com/10.1007/s10886-016-0686-y},
	doi = {10.1007/s10886-016-0686-y},
	abstract = {Entomopathogenic nematodes ({EPNs}) play a role in indirect defense of plants under attack by root herbivores. Several investigations have shown that {EPNs} are attracted or repelled by various volatile compounds ({VOCs}) released from insect damaged plant roots. We hypothesized that the directional responses of {EPNs} to the {VOCs} would be affected by foraging strategy and would vary among species, {VOC} type, and {VOC} concentrations. We tested the chemotactic responses of four commercial {EPN} species (Steinernema feltiae, S. carpocapsae, S. kraussei, and Heterorhabditis bacteriophora) to seven compounds released from insect (Melolontha hippocastani)-damaged (decanal, nonanal, octanal, undecane, 6-methyl-5-hepten-2one, and 1,2,4-trimethylbenzene) and undamaged (2-ethyl-1hexanol) potato tubers. Our results suggest that {EPNs} are able to distinguish herbivore-induced {VOCs} from those that are typical for healthy potato tubers. In our investigation, nonanal, octanal, and decanal had a greater influence on the movement of {EPNs} than other tested synthetic volatiles. Decanal was an attractant for H. bacteriophora and S. kraussei at both tested concentrations (as a pure compound and at a concentration of 0.03 ppm). The results suggest that the susceptibility to perception of chemical stimuli from the environment is a species-specific characteristic that prevails over the influence of the foraging strategy.},
	pages = {314--322},
	number = {4},
	journaltitle = {Journal of Chemical Ecology},
	author = {Laznik, Žiga and Trdan, Stanislav},
	urldate = {2019-04-23},
	date = {2016-04},
	langid = {english},
	keywords = {steinernema feltiae},
	file = {Laznik et Trdan - 2016 - Attraction Behaviors of Entomopathogenic Nematodes.pdf:/Users/cmaslard/Zotero/storage/5F78DTHM/Laznik et Trdan - 2016 - Attraction Behaviors of Entomopathogenic Nematodes.pdf:application/pdf;Laznik et Trdan - 2016 - Attraction Behaviors of Entomopathogenic Nematodes.pdf:/Users/cmaslard/Zotero/storage/ABYQD2E6/Laznik et Trdan - 2016 - Attraction Behaviors of Entomopathogenic Nematodes.pdf:application/pdf;Laznik_Trdan_2016_Attraction Behaviors of Entomopathogenic Nematodes (Steinernematidae and.pdf:/Users/cmaslard/Zotero/storage/6FIGWJTN/Laznik_Trdan_2016_Attraction Behaviors of Entomopathogenic Nematodes (Steinernematidae and.pdf:application/pdf},
}

@article{beck_improving_2014,
	title = {Improving the biocontrol potential of \textit{Steinernema feltiae} against \textit{Delia radicum} through dosage, application technique and timing: Improving the biocontrol potential of \textit{Steinernema feltiae} against \textit{Delia radicum}},
	volume = {70},
	issn = {1526498X},
	url = {http://doi.wiley.com/10.1002/ps.3628},
	doi = {10.1002/ps.3628},
	shorttitle = {Improving the biocontrol potential of \textit{Steinernema feltiae} against \textit{Delia radicum} through dosage, application technique and timing},
	abstract = {{BACKGROUND} The potential of the entomopathogenic nematode ({EPN}) Steinernema feltiae Filipjev as a biocontrol agent against the cabbage maggot Delia radicum (L.), was assessed in three field tests, focusing on {EPN} dosage, application technique and timing.
{RESULTS} Spraying cabbage plant trays with different doses of infective juveniles ({IJs}) (50,000, 100,000 and 200,000 per plant) generated a similar reduction of plant mortality. Spraying plant trays with 200,000 {IJs} of S. feltiae per plant temporarily reduced the number of maggots around the plants’ roots, while neither spraying a lower dose (50,000 {IJs}/plant) nor soil drenching with 200,000 or 50,000 {EPN}/plant) reduced maggot numbers. When applied as a plant tray spray, {IJs} of S. feltiae took 1-2 weeks to spread through the soil surrounding the roots. The pathogenicity of the {EPN}, as evaluated by a Galleria mellonella bait test, was highest (up to 100\% mortality) until up to five weeks after application, and declined to control levels after 4-7 weeks. Follow-up drench applications with {EPN}, applied one and/or two weeks after the first {EPN} application, did not influence control of D. radicum.
{CONCLUSION} Plant tray spraying provides better placement of S. feltiae than soil drench treatments for control of D. radicum. Plant mortality was not dose-dependent in the presented trials, unlike the reduction of maggot numbers. Further research},
	pages = {841--851},
	number = {5},
	journaltitle = {Pest Management Science},
	author = {Beck, Bert and Spanoghe, Pieter and Moens, Maurice and Brusselman, Eva and Temmerman, Femke and Pollet, Sabien and Nuyttens, David},
	urldate = {2019-04-23},
	date = {2014-05},
	langid = {english},
	keywords = {delia radicum, Technicienne, biocontrol, steinernema feltiae},
	file = {Beck et al_2014_Improving the biocontrol potential of iSteinernema feltiae-i against.pdf:/Users/cmaslard/Zotero/storage/JUDEIG9G/Beck et al_2014_Improving the biocontrol potential of iSteinernema feltiae-i against.pdf:application/pdf;Beck et al. - 2014 - Improving the biocontrol potential of iSteinerne.pdf:/Users/cmaslard/Zotero/storage/4VP8XQ4A/Beck et al. - 2014 - Improving the biocontrol potential of iSteinerne.pdf:application/pdf;Beck et al. - 2014 - Improving the biocontrol potential of iSteinerne.pdf:/Users/cmaslard/Zotero/storage/LK6BAUT8/Beck et al. - 2014 - Improving the biocontrol potential of iSteinerne.pdf:application/pdf;Beck et al. - 2014 - Improving the biocontrol potential of iSteinerne.pdf:/Users/cmaslard/Zotero/storage/TYUVTDQX/Beck et al. - 2014 - Improving the biocontrol potential of iSteinerne.pdf:application/pdf;Beck et al. - 2014 - Improving the biocontrol potential of iSteinerne.pdf:/Users/cmaslard/Zotero/storage/AK35CGM7/Beck et al. - 2014 - Improving the biocontrol potential of iSteinerne.pdf:application/pdf},
}

@article{brown_morphology_1998,
	title = {Morphology and ultrastructure of sense organs on the ovipositor of Trybliographa rapae, a parasitoid of the cabbage root fly},
	volume = {44},
	issn = {00221910},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0022191098000729},
	doi = {10.1016/S0022-1910(98)00072-9},
	abstract = {The ovipositor of the parasitoid wasp Trybliographa rapae was examined by scanning and transmission electron microscopy. Characteristic peg-like sensilla with a cuticular ring at the base are found at the tip of the ventral valves, where they occur in a characteristic arrangement of triplets. The unusual basal structure probably protects the sensilla against damage during movement through the substrate and piercing of the host cuticle. These sensilla are each innervated by six dendrites, some of which have lamellated tips, generally considered to be characteristic of thermosensitivity. It is suggested that the remaining dendrites are gustatory, and as such probably respond to factors present in host haemolymph. A second type of peg-like sensillum is found on both the dorsal and the ventral valves. These are set in deep pits so that only the tip of the peg protrudes above the surface of the cuticle. These occur along the length of the ovipositor shaft and ultrastructural studies reveal the pegs to be innervated by a single mechanosensitive dendrite, probably monitoring the movement of the ovipositor through the substrate. © 1998 Elsevier Science Ltd. All rights reserved.},
	pages = {1017--1025},
	number = {11},
	journaltitle = {Journal of Insect Physiology},
	author = {Brown, Paul E and Anderson, Moray},
	urldate = {2019-04-23},
	date = {1998-11},
	langid = {english},
	keywords = {delia radicum},
	file = {Brown et Anderson - 1998 - Morphology and ultrastructure of sense organs on t.pdf:/Users/cmaslard/Zotero/storage/TQW52YEP/Brown et Anderson - 1998 - Morphology and ultrastructure of sense organs on t.pdf:application/pdf;Brown et Anderson - 1998 - Morphology and ultrastructure of sense organs on t.pdf:/Users/cmaslard/Zotero/storage/958WM4N6/Brown et Anderson - 1998 - Morphology and ultrastructure of sense organs on t.pdf:application/pdf},
