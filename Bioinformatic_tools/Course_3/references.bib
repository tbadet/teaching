@article{sun_detoxification_2020,
	title = {Detoxification of plant defensive glucosinolates by an herbivorous caterpillar is beneficial to its endoparasitic wasp},
	volume = {29},
	issn = {0962-1083, 1365-294X},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/mec.15613},
	doi = {10.1111/mec.15613},
	abstract = {Plant chemical defences impact not only herbivores, but also organisms in higher trophic levels that prey on or parasitize herbivores. While herbivorous insects can often detoxify plant chemicals ingested from suitable host plants, how such detoxification affects endoparasitoids that use these herbivores as hosts is largely unknown. Here, we used transformed plants to experimentally manipulate the major detoxification reaction used by Plutella xylostella (diamondback moth) to deactivate the glucosinolate defences of its Brassicaceae host plants. We then assessed the developmental, metabolic, immune, and reproductive consequences of this genetic manipulation on the herbivore as well as its hymenopteran endoparasitoid Diadegma semiclausum. Inhibition of P. xylostella glucosinolate metabolism by plant-mediated {RNA} interference increased the accumulation of the principal glucosinolate activation products, the toxic isothiocyanates, in the herbivore, with negative effects on its growth. Although the endoparasitoid manipulated the excretion of toxins by its insect host to its own advantage, the inhibition of herbivore glucosinolate detoxification slowed endoparasitoid development, impaired its reproduction, and suppressed the expression of genes of a parasitoid-symbiotic polydnavirus that aids parasitism. Therefore, the detoxification of plant glucosinolates by an herbivore lowers its toxicity as a host and benefits the parasitoid D. semiclausum at multiple levels.},
	pages = {4014--4031},
	number = {20},
	journaltitle = {Molecular Ecology},
	shortjournal = {Molecular Ecology},
	author = {Sun, Ruo and Gols, Rieta and Harvey, Jeffrey A. and Reichelt, Michael and Gershenzon, Jonathan and Pandit, Sagar S. and Vassão, Daniel G.},
	urldate = {2025-08-05},
	date = {2020-10},
	langid = {english},
	file = {PDF:/Users/cmaslard/Zotero/storage/PMBK5RPE/Sun et al. - 2020 - Detoxification of plant defensive glucosinolates by an herbivorous caterpillar is beneficial to its.pdf:application/pdf},
}

@article{stuttmann_highly_2021,
	title = {Highly efficient multiplex editing: one‐shot generation of 8× \textit{Nicotiana benthamiana} and 12× Arabidopsis mutants},
	volume = {106},
	issn = {0960-7412, 1365-313X},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/tpj.15197},
	doi = {10.1111/tpj.15197},
	shorttitle = {Highly efficient multiplex editing},
	abstract = {Genome editing by {RNA}-guided nucleases, such as {SpCas}9, has been used in numerous different plant species. However, to what extent multiple independent loci can be targeted simultaneously by multiplexing has not been well documented. Here, we developed a toolkit, based on a highly intron-optimized {zCas}9i gene, which allows assembly of nuclease constructs expressing up to 32 single guide {RNAs} ({sgRNAs}). We used this toolkit to explore the limits of multiplexing in two major model species, and report on the isolation of transgene-free octuple (83) Nicotiana benthamiana and duodecuple (123) Arabidopsis thaliana mutant lines in a single generation (T1 and T2, respectively). We developed novel counter-selection markers for N. benthamiana, most importantly Sl-{FAST}2, comparable to the well-established Arabidopsis seed ﬂuorescence marker, and {FCY}-{UPP}, based on the production of toxic 5-ﬂuorouracil in the presence of a precursor. Targeting eight genes with an array of nine different {sgRNAs} and relying on {FCY}-{UPP} for selection of non-transgenic T1, we identiﬁed N. benthamiana mutant lines with astonishingly high efﬁciencies: All analyzed plants carried mutations in all genes (approximately 112/116 target sites edited). Furthermore, we targeted 12 genes by an array of 24 {sgRNAs} in A. thaliana. Efﬁciency was signiﬁcantly lower in A. thaliana, and our results indicate Cas9 availability is the limiting factor in such higher-order multiplexing applications. We identiﬁed a duodecuple mutant line by a combination of phenotypic screening and amplicon sequencing. The resources and results presented provide new perspectives for how multiplexing can be used to generate complex genotypes or to functionally interrogate groups of candidate genes.},
	pages = {8--22},
	number = {1},
	journaltitle = {The Plant Journal},
	shortjournal = {The Plant Journal},
	author = {Stuttmann, Johannes and Barthel, Karen and Martin, Patrick and Ordon, Jana and Erickson, Jessica L. and Herr, Rosalie and Ferik, Filiz and Kretschmer, Carola and Berner, Thomas and Keilwagen, Jens and Marillonnet, Sylvestre and Bonas, Ulla},
	urldate = {2025-08-05},
	date = {2021-04},
	langid = {english},
	file = {PDF:/Users/cmaslard/Zotero/storage/S3X5ATHK/Stuttmann et al. - 2021 - Highly efficient multiplex editing one‐shot generation of 8× Nicotiana benthamiana and 12× A.pdf:application/pdf},
