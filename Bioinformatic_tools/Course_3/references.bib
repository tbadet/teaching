@article{gomez_susceptibility_2015,
	title = {Susceptibility variation to different entomopathogenic nematodes in Strategus aloeus L (Coleoptera: Scarabaeidae)},
	volume = {4},
	issn = {2193-1801},
	url = {http://www.springerplus.com/content/4/1/620},
	doi = {10.1186/s40064-015-1412-x},
	shorttitle = {Susceptibility variation to different entomopathogenic nematodes in Strategus aloeus L (Coleoptera},
	abstract = {Strategus aloeus L (Coleoptera: Scarabaeidae), known as “Little bull” or oil palm “chiza” is a limiting pest in palm planta‑tion in Cesar Colombia. Its management is based on pesticide use or old palm removal in renewal lots. Therefore, other alternatives are being sought out. Entomopathogenic nematodes isolated from the Colombian Andean region were evaluated. Under laboratory conditions S. aloeus third instar larvae exposure to 160 infective juveniles ({IJs}) per/cm2 Steinernema sp3 {JCL}027, S. feltiae {SCT}125, S. websteri {JCL}006, S. colombiense {SNI}0198, Heterorhabditis bacteriophora {HNI}0100, H. bacteriophora {HASA}702, H. indica {SL}0708 (n = 20) was evaluated under a completely rand‑omized design. The experiment was repeated three times on different dates. Significant differences were observed (F = 11.127, df = 7. 24, p = 0.0054), registering mortality between 3 and 14 days. Steinernema sp3 {JCL}027 was the strain producing the highest mortality rate (19.3 ± 8 \%), followed by H. bacteriophora {HNI}0100 (5.2 ± 9 \%). Thus, we evaluated Steinernema sp3 {JCL}0270 using a randomized design at 0, 160, 290, 420, 550, 680, 810 {IJs}/cm2 (n = 12). The experiment was repeated three times on different dates. Significant differences were found among treatments (44 ± 5 \%, F = 14.676; df = 6. 21, p = 0.001), with 680 {IJs}/cm2 producing the highest mortality followed by 810 {IJs}/ cm2 (22 ± 5 \%). In conclusion, this alternative must be further explored in search of pesticide use and cost reduction, in addition to young palm loss in a plantation.},
	number = {1},
	journaltitle = {{SpringerPlus}},
	author = {Gómez, A. and Sáenz-Aponte, A.},
	urldate = {2019-04-23},
	date = {2015-12},
	langid = {english},
	keywords = {lue, steinernema feltiae},
	file = {Gómez et Sáenz-Aponte - 2015 - Susceptibility variation to different entomopathog.pdf:/Users/cmaslard/Zotero/storage/FV2MRJ3K/Gómez et Sáenz-Aponte - 2015 - Susceptibility variation to different entomopathog.pdf:application/pdf;Gómez et Sáenz-Aponte - 2015 - Susceptibility variation to different entomopathog.pdf:/Users/cmaslard/Zotero/storage/K8I2CXJJ/Gómez et Sáenz-Aponte - 2015 - Susceptibility variation to different entomopathog.pdf:application/pdf;Gómez_Sáenz-Aponte_2015_Susceptibility variation to different entomopathogenic nematodes in Strategus.pdf:/Users/cmaslard/Zotero/storage/VP3Q9BCT/Gómez_Sáenz-Aponte_2015_Susceptibility variation to different entomopathogenic nematodes in Strategus.pdf:application/pdf},
}

@article{ali_ice-active_2016,
	title = {Ice-Active Substances from the Infective Juveniles of the Freeze Tolerant Entomopathogenic Nematode, Steinernema feltiae},
	volume = {11},
	issn = {1932-6203},
	url = {https://dx.plos.org/10.1371/journal.pone.0156502},
	doi = {10.1371/journal.pone.0156502},
	abstract = {Steinernema feltiae is a moderately freezing tolerant nematode, that can withstand intracellular ice formation. We investigated recrystallization inhibition, thermal hysteresis and ice nucleation activities in the infective juveniles of S. feltiae. Both the splat cooling assay and optical recrystallometry indicate the presence of ice active substances that inhibit recrystallization in the nematode extract. The substance is relatively heat stable and largely retains the recrystallization inhibition activity after heating. No thermal hysteresis activity was detected but the extract had a typical hexagonal crystal shape when grown from a single seed crystal and weak ice nucleation activity. An ice active substance is present in a low concentration, which may be involved in the freezing survival of this species by inhibiting ice recrystallization.},
	pages = {e0156502},
	number = {5},
	journaltitle = {{PLOS} {ONE}},
	author = {Ali, Farman and Wharton, David A.},
	editor = {Wright, Neil T},
	urldate = {2019-04-23},
	date = {2016-05-26},
	langid = {english},
	keywords = {lue, steinernema feltiae},
	file = {Ali et Wharton - 2016 - Ice-Active Substances from the Infective Juveniles.pdf:/Users/cmaslard/Zotero/storage/7LT5VKBZ/Ali et Wharton - 2016 - Ice-Active Substances from the Infective Juveniles.pdf:application/pdf;Ali et Wharton - 2016 - Ice-Active Substances from the Infective Juveniles.pdf:/Users/cmaslard/Zotero/storage/GSP4Z5MY/Ali et Wharton - 2016 - Ice-Active Substances from the Infective Juveniles.pdf:application/pdf;Ali_Wharton_2016_Ice-Active Substances from the Infective Juveniles of the Freeze Tolerant.pdf:/Users/cmaslard/Zotero/storage/XA7AMLFB/Ali_Wharton_2016_Ice-Active Substances from the Infective Juveniles of the Freeze Tolerant.pdf:application/pdf},
}

@article{buitenhuis_efficacy_2005,
	title = {Efficacy of Entomopathogenic Nematode {\textless}I{\textgreater}Steinernema feltiae{\textless}/I{\textgreater} (Rhabditida: Steinernematidae) as Influenced by {\textless}I{\textgreater}Frankliniella occidentalis{\textless}/I{\textgreater} (Thysanoptera: Thripidae) Developmental Stage and Host Plant Stage},
	volume = {98},
	issn = {00220493, 00220493},
	url = {http://openurl.ingenta.com/content/xref?genre=article&issn=0022-0493&volume=98&issue=5&spage=1480},
	doi = {10.1603/0022-0493-98.5.1480},
	shorttitle = {Efficacy of Entomopathogenic Nematode {\textless}I{\textgreater}Steinernema feltiae{\textless}/I{\textgreater} (Rhabditida},
	abstract = {Entomopathogenic nematodes were investigated as an alternative biological control strategy for western ßower thrips, Frankliniella occidentalis (Pergande) (Thysanoptera: Thripidae), in ornamental greenhouse crops, by using potted chrysanthemum as a model crop. The susceptibility of various life stages of F. occidentalis to different concentrations of the nematode Steinernema feltiae (Filipjev) (Rhabditida: Steinernematidae) was investigated in petri dish bioassays. This was followed with trials using potted chrysanthemums comparing the {efÞcacy} of nematode application to plants in vegetative (exposed habitat) versus ßowering (cryptic habitat) stages. In both trials, the effect of the wetting agent Agral 90 (nonylphenoxy polyethoxyethanol), which is used in combination with the nematode spray, on F. occidentalis mortality was assessed. In petri dish trials, the prepupae and pupae were the most susceptible developmental stages of F. occidentalis to infection by S. feltiae. First and second instars were killed by very high rates of nematodes (Ն20,000 infective juveniles per milliliter), but corrected mortality was only Ϸ28 Ð37\%. No {signiÞcant} mortality was observed for adult thrips. Results from the petri dish trials were {conÞrmed} on chrysanthemum plants. Foliar application of S. feltiae did not result in {signiÞcant} mortality in larvae or adults. No {signiÞcant} differences in {efÞcacy} were detected by application of nematodes on vegetative versus ßowering chrysanthemum. Agral 90 had a {signiÞcant} impact on mortality on the Þrst stage larvae and prepupae in the petri dish trials but not in the plant trials. Thrips control by S. feltiae in greenhouses may be partly or completely due to prepupal and pupal mortality.},
	pages = {1480--1485},
	number = {5},
	journaltitle = {Journal of Economic Entomology},
	author = {Buitenhuis, R. and Shipp, J. L.},
	urldate = {2019-04-23},
	date = {2005-10-01},
	langid = {english},
	keywords = {lue, steinernema feltiae},
	file = {Buitenhuis et Shipp - 2005 - Efficacy of Entomopathogenic Nematode ISteinerne.pdf:/Users/cmaslard/Zotero/storage/8ZS5FD67/Buitenhuis et Shipp - 2005 - Efficacy of Entomopathogenic Nematode ISteinerne.pdf:application/pdf;Buitenhuis et Shipp - 2005 - Efficacy of Entomopathogenic Nematode ISteinerne.pdf:/Users/cmaslard/Zotero/storage/XQCDCCU9/Buitenhuis et Shipp - 2005 - Efficacy of Entomopathogenic Nematode ISteinerne.pdf:application/pdf;Buitenhuis et Shipp - 2005 - Efficacy of Entomopathogenic Nematode ISteinerne.pdf:/Users/cmaslard/Zotero/storage/5USW8MWK/Buitenhuis et Shipp - 2005 - Efficacy of Entomopathogenic Nematode ISteinerne.pdf:application/pdf;haukeland2010.pdf:/Users/cmaslard/Zotero/storage/DLVYJTFS/haukeland2010.pdf:application/pdf;haukeland2010.pdf:/Users/cmaslard/Zotero/storage/WAGTV793/haukeland2010.pdf:application/pdf},
}

@article{brivio_nematobacterial_2018,
	title = {Nematobacterial Complexes and Insect Hosts: Different Weapons for the Same War},
	volume = {9},
	issn = {2075-4450},
	url = {http://www.mdpi.com/2075-4450/9/3/117},
	doi = {10.3390/insects9030117},
	shorttitle = {Nematobacterial Complexes and Insect Hosts},
	abstract = {Entomopathogenic nematodes ({EPNs}) are widely used as biological control agents against insect pests, the efﬁcacy of these organisms strongly depends on the balance between the parasitic strategies and the immune response of the host. This review summarizes roles and relationships between insect hosts and two well-known {EPN} species, Steinernema feltiae and Steinernema carpocapsae and outlines the main mechanisms of immune recognition and defense of insects. Analyzing information and ﬁndings about these {EPNs}, it is clear that these two species use shared immunosuppression strategies, mainly mediated by their symbiotic bacteria, but there are differences in both the mechanism of evasion and interference of the two nematodes with the insect host immune pathways. Based on published data, S. feltiae takes advantage of the cross reaction between its body surface and some host functional proteins, to inhibit defensive processes; otherwise, secretion/excretion products from S. carpocapsae seem to be the main nematode components responsible for the host immunosuppression.},
	pages = {117},
	number = {3},
	journaltitle = {Insects},
	author = {Brivio, Maurizio and Mastore, Maristella},
	urldate = {2019-04-23},
	date = {2018-09-11},
	langid = {english},
	keywords = {lue, bacteria, steinernema feltiae, Xenorhabdus, top, Steinernema carpocapsae},
	file = {Brivio et Mastore - 2018 - Nematobacterial Complexes and Insect Hosts Differ.pdf:/Users/cmaslard/Zotero/storage/QKGWDEGX/Brivio et Mastore - 2018 - Nematobacterial Complexes and Insect Hosts Differ.pdf:application/pdf;Brivio et Mastore - 2018 - Nematobacterial Complexes and Insect Hosts Differ.pdf:/Users/cmaslard/Zotero/storage/IZPCS56A/Brivio et Mastore - 2018 - Nematobacterial Complexes and Insect Hosts Differ.pdf:application/pdf;Brivio_Mastore_2018_Nematobacterial Complexes and Insect Hosts.pdf:/Users/cmaslard/Zotero/storage/LFL6PQSL/Brivio_Mastore_2018_Nematobacterial Complexes and Insect Hosts.pdf:application/pdf},
}

@article{archana_efficacy_2017,
	title = {Efficacy of entomopathogenic nematodes (Rhabditida: Steinernematidae and Heterorhabditidae) on developmental stages of house fly, Musca domestica},
	volume = {41},
	issn = {0971-7196, 0975-0703},
	url = {http://link.springer.com/10.1007/s12639-017-0889-3},
	doi = {10.1007/s12639-017-0889-3},
	shorttitle = {Efficacy of entomopathogenic nematodes (Rhabditida},
	abstract = {The houseﬂy, Musca domestica is a major domestic, medical and veterinary pest. The management of these ﬂies reliance on insecticide, causes environmental constraints, insecticide resistance and residues in the meat, skin. Therefore one of the eco-friendly alternate methods is by using biological agents such as entomopathogenic nematodes ({EPN}). In the present study evaluated the survival of {EPN} species Steinernema feltiae, Heterorhabditis indica, S. carpocapsae, S. glaseri and S. abbasi in poultry manure and also their efﬁcacy against different developmental stages of house ﬂy. After exposing to poultry manure, S. feltiae showed more survival as followed by H. indica, S. carpocapsae, S. glaseri and S. abbasi in all exposition period. When the exposition period extended to 96 h, all nematode species survivability was drastically reduced. After exposing these nematodes to poultry manure at 24 h their virulence capacity against wax moth, Galleria mellonella showed all the nematode species were able cause 100\% mortality. However their progeny production was signiﬁcantly reduced. Fly eggs and pupae were refractory to these nematode infection. Petri dish without artiﬁcial diet assay showed that, second and 3rd-instar larvae were highly susceptible to {EPNs} as compared to larvae provided with artiﬁcial diet. H. indica showed high virulence capacity compared to other nematodes tested.},
	pages = {782--794},
	number = {3},
	journaltitle = {Journal of Parasitic Diseases},
	author = {Archana, M. and D’Souza, Placid E. and Patil, Jagadeesh},
	urldate = {2019-04-23},
	date = {2017-09},
	langid = {english},
	keywords = {lue, steinernema feltiae},
	file = {Archana et al_2017_Efficacy of entomopathogenic nematodes (Rhabditida.pdf:/Users/cmaslard/Zotero/storage/XZN967QL/Archana et al_2017_Efficacy of entomopathogenic nematodes (Rhabditida.pdf:application/pdf;Archana et al. - 2017 - Efficacy of entomopathogenic nematodes (Rhabditida.pdf:/Users/cmaslard/Zotero/storage/WZIZ6CY6/Archana et al. - 2017 - Efficacy of entomopathogenic nematodes (Rhabditida.pdf:application/pdf;Archana et al. - 2017 - Efficacy of entomopathogenic nematodes (Rhabditida.pdf:/Users/cmaslard/Zotero/storage/UVJFT796/Archana et al. - 2017 - Efficacy of entomopathogenic nematodes (Rhabditida.pdf:application/pdf},
}

