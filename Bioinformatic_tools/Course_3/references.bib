	number = {2},
	journaltitle = {New Phytologist},
	shortjournal = {New Phytologist},
	author = {Coleman‐Derr, Devin and Desgarennes, Damaris and Fonseca‐Garcia, Citlali and Gross, Stephen and Clingenpeel, Scott and Woyke, Tanja and North, Gretchen and Visel, Axel and Partida‐Martinez, Laila P. and Tringe, Susannah G.},
	urldate = {2023-10-18},
	date = {2016-01},
	langid = {english},
	keywords = {microbial communities🦠},
	file = {New Phytologist - 2015 - Coleman‐Derr - Plant compartment and biogeography affect microbiome composition in cultivated and.pdf:/Users/cmaslard/Zotero/storage/B7ZTZW5S/New Phytologist - 2015 - Coleman‐Derr - Plant compartment and biogeography affect microbiome composition in cultivated and.pdf:application/pdf},
