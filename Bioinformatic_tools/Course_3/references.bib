@article{morison_interactions_1999,
	title = {Interactions between increasing {CO} $_{\textrm{2}}$ concentration and temperature on plant growth},
	volume = {22},
	issn = {0140-7791, 1365-3040},
	url = {http://doi.wiley.com/10.1046/j.1365-3040.1999.00443.x},
	doi = {10.1046/j.1365-3040.1999.00443.x},
	abstract = {The global environment is changing with increasing temperature and atmospheric carbon dioxide concentration, [{CO}2]. Because these two factors are concomitant, and the global [{CO}2] rise will affect all biomes across the full global range of temperatures, it is essential to review the theory and observations on effects of temperature and [{CO}2] interactions on plant carbon balance, growth, development, biomass accumulation and yield. Although there are sound theoretical reasons for expecting a larger stimulation of net {CO}2 assimilation rates by increased [{CO}2] at higher temperatures, this does not necessarily mean that the pattern of biomass and yield responses to increasing [{CO}2] and temperature is determined by this response. This paper reviews the interactions between the effects of [{CO}2] and temperature on plants. There is little unequivocal evidence for large differences in response to [{CO}2] at different temperatures, as studies are confounded by the different responses of species adapted and acclimated to different temperatures, and the interspecific differences in growth form and development pattern. We conclude by stressing the importance of initiation and expansion of meristems and organs and the balance between assimilate supply and sink activity in determining the growth response to increasing [{CO}2] and temperature.},
	pages = {659--682},
	number = {6},
	journaltitle = {Plant, Cell and Environment},
