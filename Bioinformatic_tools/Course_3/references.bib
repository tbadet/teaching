@article{jess_biological_2004,
	title = {Biological control of sciarid and phorid pests of mushroom with predatory mites from the genus Hypoaspis (Acari: Hypoaspidae) and the entomopathogenic nematode Steinernema feltiae},
	volume = {94},
	issn = {0007-4853, 1475-2670},
	url = {http://www.journals.cambridge.org/abstract_S0007485304000173},
	doi = {10.1079/BER2003286},
	shorttitle = {Biological control of sciarid and phorid pests of mushroom with predatory mites from the genus Hypoaspis (Acari},
	abstract = {In small-scale experiments, the predatory mites, Hypoaspis aculeifer (Canestrini) and H. miles Berlese, applied at 700 mites {mϪ}2, and the entomopathogenic nematode, Steinernema feltiae (Filipjev) applied at 3 ϫ 10Ϫ6 nematodes {mϪ}2 controlled sciarids and phorids in mushroom compost and casing substrates. For both mite species, earliest application to the growing substrate following sciarid infestation reduced sciarid emergence. In contrast, later application of each biological control agent provided more effective control of phorid emergence. The behaviour of adult mites suggested that H. aculeifer were more positively geotactic than H. miles although both species could penetrate compost and casing substrates to a depth of 2–12 cm. A majority of S. feltiae nematodes resided at a depth of 2–4 cm in both substrate types. Independent application of H. aculeifer provided more comprehensive control of sciarids and phorids than the other biological agents studied, owing to its better dispersal within compost and casing, and ability to attack larvae of differing ages.},
	pages = {159--167},
	number = {2},
	journaltitle = {Bulletin of Entomological Research},
	author = {Jess, S. and Bingham, J.F.W.},
	urldate = {2019-04-23},
	date = {2004-04},
	langid = {english},
	keywords = {lue, steinernema feltiae},
	file = {Jess et Bingham - 2004 - Biological control of sciarid and phorid pests of .pdf:/Users/cmaslard/Zotero/storage/QXRI32NS/Jess et Bingham - 2004 - Biological control of sciarid and phorid pests of .pdf:application/pdf;Jess et Bingham - 2004 - Biological control of sciarid and phorid pests of .pdf:/Users/cmaslard/Zotero/storage/DYJNWUXT/Jess et Bingham - 2004 - Biological control of sciarid and phorid pests of .pdf:application/pdf;Jess_Bingham_2004_Biological control of sciarid and phorid pests of mushroom with predatory mites.pdf:/Users/cmaslard/Zotero/storage/3379JBRD/Jess_Bingham_2004_Biological control of sciarid and phorid pests of mushroom with predatory mites.pdf:application/pdf},
