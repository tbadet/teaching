@article{thiour-mauprivez_plant_2023,
	title = {Plant mediates soil water content effects on soil microbiota independently of its water uptake},
	volume = {27},
	issn = {24522198},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2452219823001088},
	doi = {10.1016/j.rhisph.2023.100769},
	series = {3.129},
	abstract = {The on-going climate change impacts soil water distribution and availability, ranging from highly limited during droughts to excessive during rainfalls. While effects of water availability were documented for soil microbiota and plant growth, it remains unclear if the soil microbiota is directly impacted by soil water content ({SWC}) or via the plant presence and its own response to water fluctuations. Uncoupling these effects is challenging, since the plant alters {SWC} via its water-uptake and transpiration. We aimed to identify a potential effect of the plant on the soil microbiota, independent of its water uptake. We studied soil microbiota in two contrasting soils exposed to three water levels, either under the presence or absence of Brassica juncea (drought sensitive, waterlogging tolerant) or Brachypodium distachyon (drought tolerant, waterlogging sensitive). Using an automatic highthroughput watering system, we accurately maintained {SWC} levels to compensate plant water uptake and evapotranspiration, thus enabling the detection of plant effects, independently of its water uptake. Plant traits were measured and the soil bacterial and fungal communities with or without plants were analysed. We high­ lighted effects of the plant on the microbiota under varying {SWC}, independently of plant water uptake. These effects were likely instigated by the physiological state of the plant due to {SWC}, and were dependant on the plant species and the soil considered. While bacterial communities were more sensitive to {SWC} than fungal commu­ nities, we found that the fungal community in the clayey soil was directly affected by {SWC}, and could oppor­ tunistically interact with a drought sensitive plant like Brassica juncea.},
	pages = {100769},
	journaltitle = {Rhizosphere},
	shortjournal = {Rhizosphere},
	author = {Thiour-Mauprivez, Clémence and Schellenberger, Romain and Zenk, Franck and Martinet, Julien and Blouin, Manuel and Jacquiod, Samuel},
	urldate = {2023-12-13},
	date = {2023-09},
	langid = {english},
	keywords = {microbial communities🦠, water stress},
	file = {Plant mediates soil water content effects on soil microbiota independently of its water uptake_sup_data.pdf:/Users/cmaslard/Zotero/storage/WHDVAKRU/Plant mediates soil water content effects on soil microbiota independently of its water uptake_sup_data.pdf:application/pdf;Thiour-Mauprivez et al. - 2023 - Plant mediates soil water content effects on soil .pdf:/Users/cmaslard/Zotero/storage/K8TZLMNY/Thiour-Mauprivez et al. - 2023 - Plant mediates soil water content effects on soil .pdf:application/pdf},
}

@article{carson_low_2010,
	title = {Low Pore Connectivity Increases Bacterial Diversity in Soil},
	volume = {76},
	issn = {0099-2240, 1098-5336},
	url = {https://journals.asm.org/doi/10.1128/AEM.03085-09},
	doi = {10.1128/AEM.03085-09},
	abstract = {{ABSTRACT}
            
              One of soil microbiology's most intriguing puzzles is how so many different bacterial species can coexist in small volumes of soil when competition theory predicts that less competitive species should decline and eventually disappear. We provide evidence supporting the theory that low pore connectivity caused by low water potential (and therefore low water content) increases the diversity of a complex bacterial community in soil. We altered the pore connectivity of a soil by decreasing water potential and increasing the content of silt- and clay-sized particles. Two textures were created, without altering the chemical properties or mineral composition of the soil, by adding silt- and clay-sized particles of quartz to a quartz-based sandy soil at rates of 0\% (sand) or 10\% (silt+clay). Both textures were incubated at several water potentials, and the effect on the active bacterial communities was measured using terminal restriction fragment length polymorphism ({TRFLP}) of bacterial 16S {rRNA}. Bacterial richness and diversity increased as water potential decreased and soil became drier (
              P
              {\textless} 0.012), but they were not affected by texture (
              P
              {\textgreater} 0.553). Bacterial diversity increased at water potentials of ≤2.5 {kPa} in sand and ≤4.0 {kPa} in silt+clay, equivalent to ≤56\% water-filled pore space ({WFPS}) in both textures. The bacterial community structure in soil was affected by both water potential and texture (
              P
              {\textless} 0.001) and was correlated with {WFPS} (sum of squared correlations [δ
              2
              ] = 0.88,
              P
              {\textless} 0.001). These findings suggest that low pore connectivity is commonly experienced by soil bacteria under field conditions and that the theory of pore connectivity may provide a fundamental principle to explain the high diversity of bacteria in soil.},
	pages = {3936--3942},
	number = {12},
	journaltitle = {Applied and Environmental Microbiology},
	shortjournal = {Appl Environ Microbiol},
	author = {Carson, Jennifer K. and Gonzalez-Quiñones, Vanesa and Murphy, Daniel V. and Hinz, Christoph and Shaw, Jeremy A. and Gleeson, Deirdre B.},
	urldate = {2023-12-18},
	date = {2010-06-15},
	langid = {english},
	keywords = {drought🚱, microbial communities🦠, water potential},
	file = {Carson et al_2010_Low Pore Connectivity Increases Bacterial Diversity in Soil.pdf:/Users/cmaslard/Zotero/storage/IK5HPP7R/Carson et al_2010_Low Pore Connectivity Increases Bacterial Diversity in Soil.pdf:application/pdf},
}

