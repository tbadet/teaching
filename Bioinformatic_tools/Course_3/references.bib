@article{katschnig_constitutive_2015,
	title = {Constitutive high-level {SOS}1 expression and absence of {HKT}1;1 expression in the salt-accumulating halophyte Salicornia dolichostachya},
	volume = {234},
	issn = {01689452},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0168945215000552},
	doi = {10.1016/j.plantsci.2015.02.011},
	abstract = {We investigated the effects of salinity on ion accumulation and expression of candidate salt tolerance genes in the highly tolerant salt accumulating halophyte Salicornia dolichostachya and the taxonomically related glycophytic Spinacia oleracea. S. dolichostachya, in comparison with S. oleracea, constitutively expressed {SOS}1 at a high level, but did not detectably express {HKT}1;1. These ﬁndings suggest that the constitutive high level of shoot salt accumulation in S. dolichostachya is accomplished through enhancement of {SOS}1-mediated Na+ xylem loading, in combination with complete suppression of {HKT}1;1-mediated Na+ retrieval from the xylem. Our ﬁndings demonstrate the importance of gene expression comparisons between highly tolerant halophytes and taxonomically related glycophytes to improve the understanding of mechanisms of Na+ movement and salt tolerance in plants.},
