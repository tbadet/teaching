	doi = {10.1186/s12958-018-0437-8},
	abstract = {This article is a review that addresses the following topics, divided by paragraphs. The first paragraph investigates the effects of physical activity on ovarian function, analyzing in particular the changes concerning the serum concentrations of follicle-stimulating hormone, luteinizing hormone, prolactin, growth hormone, thyroid hormones, leptin, ghrelin, neuropeptide Y. The second paragraph analyzes the effects of doping on the hypothalamic-pituitaryovarian axis. Finally, the last paragraph analyzes the {PCOS} category, evaluating the effects of hyperandrogenism in relation to athletic performance.},
