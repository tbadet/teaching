@article{wang_root_2021,
	title = {Root exudate signals in plant–plant interactions},
	volume = {44},
	issn = {0140-7791, 1365-3040},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/pce.13892},
	doi = {10.1111/pce.13892},
	abstract = {Plant-to-plant signalling is a key mediator of interactions among plant species. Plants can perceive and respond to chemical cues emitted from their neighbours, altering survival and performance, impacting plant coexistence and community assembly. An increasing number of studies indicate root exudates as key players in plant-to-plant signalling. Root exudates mediate root detection and behaviour, kin recognition, flowering and production, driving inter- and intra-specific facilitation in cropping systems and mixed-species plantations. Altered interactions may be attributed to the signalling components within root exudates. Root ethylene, strigolactones, jasmonic acid, (-)-loliolide and allantoin are signalling chemicals that convey information on local conditions in plant–plant interactions. These root-secreted signalling chemicals appear ubiquitous in plants and trigger a series of belowground responses inter- and intra-specifically, involving molecular events in biosynthesis, secretion and action. The secretion of root signals, mainly mediated by {ATP}-binding cassette transporters, is critical. Root-secreted signalling chemicals and their molecular mechanisms are rapidly revealing a multitude of fascinating plant–plant interactions. However, many root signals, particularly species-specific signals and their underlying mechanisms, remain to be uncovered due to methodological limitations and root-soil interactions. A thorough understanding of root-secreted chemical signals and their mechanisms will offer many ecological implications and potential applications for sustainable agriculture.},
	pages = {1044--1058},
	number = {4},
	journaltitle = {Plant, Cell \& Environment},
	shortjournal = {Plant Cell Environ},
	author = {Wang, Nan‐Qi and Kong, Chui‐Hua and Wang, Peng and Meiners, Scott J.},
	urldate = {2021-11-25},
	date = {2021-04},
	langid = {english},
	keywords = {metabolomic},
	file = {Wang et al. - 2021 - Root exudate signals in plant–plant interactions.pdf:/Users/cmaslard/Zotero/storage/GY9CHFR2/Wang et al. - 2021 - Root exudate signals in plant–plant interactions.pdf:application/pdf},
}

@article{jorge_mass_2016,
	title = {Mass spectrometry-based plant metabolomics: Metabolite responses to abiotic stress},
	volume = {35},
	issn = {1098-2787},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/mas.21449},
	doi = {10.1002/mas.21449},
	series = {10.946},
	shorttitle = {Mass spectrometry-based plant metabolomics},
	abstract = {Metabolomics is one omics approach that can be used to acquire comprehensive information on the composition of a metabolite pool to provide a functional screen of the cellular state. Studies of the plant metabolome include analysis of a wide range of chemical species with diverse physical properties, from ionic inorganic compounds to biochemically derived hydrophilic carbohydrates, organic and amino acids, and a range of hydrophobic lipid-related compounds. This complexitiy brings huge challenges to the analytical technologies employed in current plant metabolomics programs, and powerful analytical tools are required for the separation and characterization of this extremely high compound diversity present in biological sample matrices. The use of mass spectrometry ({MS})-based analytical platforms to profile stress-responsive metabolites that allow some plants to adapt to adverse environmental conditions is fundamental in current plant biotechnology research programs for the understanding and development of stress-tolerant plants. In this review, we describe recent applications of metabolomics and emphasize its increasing application to study plant responses to environmental (stress-) factors, including drought, salt, low oxygen caused by waterlogging or flooding of the soil, temperature, light and oxidative stress (or a combination of them). Advances in understanding the global changes occurring in plant metabolism under specific abiotic stress conditions are fundamental to enhance plant fitness and increase stress tolerance. © 2015 Wiley Periodicals, Inc. Mass Spec Rev 35:620–649, 2016},
	pages = {620--649},
	number = {5},
	journaltitle = {Mass Spectrometry Reviews},
	author = {Jorge, Tiago F. and Rodrigues, João A. and Caldana, Camila and Schmidt, Romy and van Dongen, Joost T. and Thomas-Oates, Jane and António, Carla},
	urldate = {2021-11-25},
	date = {2016},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/mas.21449},
	keywords = {metabolomic, abiotic stress, compatible solutes, {GC}–{MS}, {LC}–{MS}, mass spectrometry, osmolytes, plant metabolomics},
	file = {Snapshot:/Users/cmaslard/Zotero/storage/3A9WT7QK/mas.html:text/html},
}

