publisher: Sciendo/De Gruyter},
	keywords = {drought🚱, heat stress 🔥, yield, inciteful.xyz, water stress, growth, high temperature, management practices, root and shoot, tolerance mechanisms},
	file = {Lipiec et al_2013_Effect of drought and heat stresses on plant growth and yield.pdf:/Users/cmaslard/Zotero/storage/MZSRRT8G/Lipiec et al_2013_Effect of drought and heat stresses on plant growth and yield.pdf:application/pdf},
