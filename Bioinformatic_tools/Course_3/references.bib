@article{rivero_developing_2022,
	title = {Developing climate‐resilient crops: improving plant tolerance to stress combination},
	volume = {109},
	issn = {0960-7412, 1365-313X},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/tpj.15483},
	doi = {10.1111/tpj.15483},
	shorttitle = {Developing climate‐resilient crops},
	abstract = {Global warming and climate change are driving an alarming increase in the frequency and intensity of different abiotic stresses, such as droughts, heat waves, cold snaps, and ﬂooding, negatively affecting crop yields and causing food shortages. Climate change is also altering the composition and behavior of different insect and pathogen populations adding to yield losses worldwide. Additional constraints to agriculture are caused by the increasing amounts of human-generated pollutants, as well as the negative impact of climate change on soil microbiomes. Although in the laboratory, we are trained to study the impact of individual stress conditions on plants, in the ﬁeld many stresses, pollutants, and pests could simultaneously or sequentially affect plants, causing conditions of stress combination. Because climate change is expected to increase the frequency and intensity of such stress combination events (e.g., heat waves combined with drought, ﬂooding, or other abiotic stresses, pollutants, and/or pathogens), a concentrated effort is needed to study how stress combination is affecting crops. This need is particularly critical, as many studies have shown that the response of plants to stress combination is unique and cannot be predicted from simply studying each of the different stresses that are part of the stress combination. Strategies to enhance crop tolerance to a particular stress may therefore fail to enhance tolerance to this speciﬁc stress, when combined with other factors. Here we review recent studies of stress combinations in different plants and propose new approaches and avenues for the development of stress combination- and climate change-resilient crops.},
	pages = {373--389},
	number = {2},
	journaltitle = {The Plant Journal},
	shortjournal = {The Plant Journal},
	author = {Rivero, Rosa M. and Mittler, Ron and Blumwald, Eduardo and Zandalinas, Sara I.},
	urldate = {2022-06-24},
	date = {2022-01},
	langid = {english},
	note = {tex.ids= {RiveroDevelopingclimateresilient}2022a, gecko3747, {riveroDevelopingClimateresilientCrops}2021},
	keywords = {drought🚱, heat stress 🔥, inciteful.xyz, climate change},
	file = {Rivero et al_2022_Developing climate‐resilient crops.pdf:/Users/cmaslard/Zotero/storage/B65CHR5T/Rivero et al_2022_Developing climate‐resilient crops.pdf:application/pdf;Rivero et al_2022_Developing climate‐resilient crops.pdf:/Users/cmaslard/Zotero/storage/TWIUA9XY/Rivero et al_2022_Developing climate‐resilient crops.pdf:application/pdf;Rivero et al. - 2022 - Developing climate‐resilient crops improving plan.pdf:/Users/cmaslard/Zotero/storage/T8AS28J9/Rivero et al. - 2022 - Developing climate‐resilient crops improving plan.pdf:application/pdf},
}

