@article{laforest-lapointe_host_2016,
	title = {Host species identity, site and time drive temperate tree phyllosphere bacterial community structure},
	volume = {4},
	issn = {2049-2618},
	url = {http://microbiomejournal.biomedcentral.com/articles/10.1186/s40168-016-0174-1},
	doi = {10.1186/s40168-016-0174-1},
	series = {14.65},
	abstract = {Background: The increasing awareness of the role of phyllosphere microbial communities in plant health calls for a greater understanding of their structure and dynamics in natural ecosystems. Since most knowledge of tree phyllosphere bacterial communities has been gathered in tropical forests, our goal was to characterize the community structure and assembly dynamics of phyllosphere epiphytic bacterial communities in temperate forests in Quebec, Canada. We targeted five dominant tree species: Acer saccharum, Acer rubrum, Betula papyrifera, Abies balsamea, and Picea glauca. We collected 180 samples of phyllosphere communities on these species at four natural forest sites, three times during the growing season.
Results: Host functional traits (i.e., wood density, leaf nitrogen content) and climate variables (summer mean temperature and precipitation) were strongly correlated with community structure. We highlight three key findings: (1) temperate tree species share a “core microbiome”; (2) significant evolutionary associations exist between groups of bacteria and host species; and (3) a greater part of the variation in phyllosphere bacterial community assembly is explained by host species identity (27 \%) and species-site interaction (14 \%), than by site (11 \%) or time (1 \%).
Conclusions: We demonstrated that host species identity is a stronger driver of temperate tree phyllosphere bacterial communities than site or time. Our results suggest avenues for future studies on the influence of host functional traits on phyllosphere community functional biogeography across terrestrial biomes.},
	pages = {27},
	number = {1},
	journaltitle = {Microbiome},
	shortjournal = {Microbiome},
	author = {Laforest-Lapointe, Isabelle and Messier, Christian and Kembel, Steven W.},
	urldate = {2023-10-13},
	date = {2016-12},
	langid = {english},
	keywords = {microbial communities🦠},
	file = {Laforest-Lapointe et al. - 2016 - Host species identity, site and time drive tempera.pdf:/Users/cmaslard/Zotero/storage/96E34AIF/Laforest-Lapointe et al. - 2016 - Host species identity, site and time drive tempera.pdf:application/pdf},
}

@article{gamalero_current_2022,
	title = {Current Techniques to Study Beneficial Plant-Microbe Interactions},
	volume = {10},
	issn = {2076-2607},
	url = {https://www.mdpi.com/2076-2607/10/7/1380},
