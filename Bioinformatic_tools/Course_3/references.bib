	author = {Ali, Amjad and Altaf, Muhammad Tanveer and Nadeem, Muhammad Azhar and Karaköy, Tolga and Shah, Adnan Noor and Azeem, Hajra and Baloch, Faheem Shehzad and Baran, Nurettin and Hussain, Tajamul and Duangpan, Saowapa and Aasim, Muhammad and Boo, Kyung-Hwan and Abdelsalam, Nader R. and Hasan, Mohamed E. and Chung, Yong Suk},
