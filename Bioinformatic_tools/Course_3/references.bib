	title = {Leaf photosynthesis and senescence in heated and droughted field-grown soybean with contrasting seed protein concentration},
	volume = {166},
	issn = {09819428},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0981942821003211},
