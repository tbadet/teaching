	keywords = {heat stress 🔥, omics👨‍💻, to\_read},
	file = {Raza et al. - 2024 - Temperature‐smart plants A new horizon with omics.pdf:/Users/cmaslard/Zotero/storage/TA54U2SK/Raza et al. - 2024 - Temperature‐smart plants A new horizon with omics.pdf:application/pdf},
