@article{hazman_laser_2023,
	title = {Laser ablation tomography monitors lateral root development in maize: a pictorial-based study case},
	volume = {46},
	issn = {1806-9959},
	url = {https://link.springer.com/10.1007/s40415-023-00925-5},
	doi = {10.1007/s40415-023-00925-5},
	shorttitle = {Laser ablation tomography monitors lateral root development in maize},
	abstract = {Laser ablation tomography ({LAT}) is a novel cutting-edge imaging technique used to investigate root geometrical and anatomical traits with no or minimal need to time-consuming or sample-destructing pre-preparations. Lateral roots ({LR}) represent an essential portion of cereal root systems, and are responsible for most of water and nutrients absorption from soil. {LAT} technology was recruited in this work to deeply visualize the initiation, development and emergence patterns of {LR} at the cellular level. Detailed fine anatomical structures of axial roots (841 μm diameter), large lateral roots (288 μm diameter) and small lateral roots (161 μm diameter) were visually revealed while all the three root classes are still vascularly connected. In the studied case, two small lateral roots emergence sites were distanced by approximately 700 μm along the axial large lateral root. The early stages of lateral root initiation and development (stages I–V) are visually demonstrated. Furthermore, fine anatomical structures shaping the vascular connection of emerged lateral root with parent roots and lignin distribution pattern were visually described. Digital staining method showed that lateral root cap is fortified with lignin, probably for protecting the emerging primordium meristem while mechanically crossing living cortical cell file of mother root. Interestingly, the {LAT} imaging could tackle the growth pattern of internal lateral root in sweet corn and rice where a lateral root could grow vertically inside aerenchyma lacunae instead of a horizontal growth through parent root cortex and protruding into the soil. Finally, {LAT} is a powerful imaging technology that can be utilized to deeply study other monocot and dicot plants for obtaining more knowledge about plant anatomical response to the surrounding environment, in addition to lateral root development and emergence.},
	pages = {1015--1025},
	number = {4},
	journaltitle = {Brazilian Journal of Botany},
	shortjournal = {Braz. J. Bot},
	author = {Hazman, Mohamed and Kabil, Farida},
	urldate = {2025-08-05},
	date = {2023-09-19},
	langid = {english},
	file = {PDF:/Users/cmaslard/Zotero/storage/FWR6RG2A/Hazman et Kabil - 2023 - Laser ablation tomography monitors lateral root development in maize a pictorial-based study case.pdf:application/pdf},
}

@article{hay_cardamine_2014,
	title = {\textit{Cardamine hirsuta} : a versatile genetic system for comparative studies},
	volume = {78},
	issn = {0960-7412, 1365-313X},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/tpj.12447},
	doi = {10.1111/tpj.12447},
	shorttitle = {\textit{Cardamine hirsuta}},
	abstract = {A major goal in biology is to identify the genetic basis for phenotypic diversity. This goal underpins research in areas as diverse as evolutionary biology, plant breeding and human genetics. A limitation for this research is no longer the availability of sequence information but the development of functional genetic tools to understand the link between changes in sequence and phenotype. Here we describe Cardamine hirsuta, a close relative of the reference plant Arabidopsis thaliana, as an experimental system in which genetic and transgenic approaches can be deployed effectively for comparative studies. We present high-resolution genetic and cytogenetic maps for C. hirsuta and show that the genome structure of C. hirsuta closely resembles the eight chromosomes of the ancestral crucifer karyotype and provides a good reference point for comparative genome studies across the Brassicaceae. We compared morphological and physiological traits between C. hirsuta and A. thaliana and analysed natural variation in stamen number in which lateral stamen loss is a species characteristic of C. hirsuta. We constructed a set of recombinant inbred lines and detected eight quantitative trait loci that can explain stamen number variation in this population. We found clear phylogeographic structure to the genetic variation in C. hirsuta, thus providing a context within which to address questions about evolutionary changes that link genotype with phenotype and the environment.},
	pages = {1--15},
	number = {1},
	journaltitle = {The Plant Journal},
	shortjournal = {The Plant Journal},
	author = {Hay, Angela S. and Pieper, Bjorn and Cooke, Elizabeth and Mandáková, Terezie and Cartolano, Maria and Tattersall, Alexander D. and Ioio, Raffaele D. and {McGowan}, Simon J. and Barkoulas, Michalis and Galinha, Carla and Rast, Madlen I. and Hofhuis, Hugo and Then, Christiane and Plieske, Jörg and Ganal, Martin and Mott, Richard and Martinez‐Garcia, Jaime F. and Carine, Mark A. and Scotland, Robert W. and Gan, Xiangchao and Filatov, Dmitry A. and Lysak, Martin A. and Tsiantis, Miltos},
	urldate = {2025-08-05},
	date = {2014-04},
	langid = {english},
	file = {PDF:/Users/cmaslard/Zotero/storage/RIQTAMZI/Hay et al. - 2014 - Cardamine hirsuta  a versatile genetic system for comparative studies.pdf:application/pdf},
}

@article{hammes_structure_2024,
	title = {Structure and Function of Auxin Transporters},
	volume = {75},
	rights = {http://creativecommons.org/licenses/by/4.0/},
	issn = {1543-5008, 1545-2123},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-arplant-070523-034109},
	doi = {10.1146/annurev-arplant-070523-034109},
	abstract = {Auxins, a group of central hormones in plant growth and development, are transported by a diverse range of transporters with distinct biochemical and structural properties. This review summarizes the current knowledge on all known auxin transporters with respect to their biochemical and biophysical properties and the methods used to characterize them. In particular, we focus on the recent advances that were made concerning the {PIN}-{FORMED} family of auxin exporters. Insights derived from solving their structures have improved our understanding of the auxin export process, and we discuss the current state of the art on {PIN}-mediated auxin transport, including the use of biophysical methods to examine their properties. Understanding the mechanisms of auxin transport is crucial for understanding plant growth and development, as well as for the development of more effective strategies for crop production and plant biotechnology.},
	pages = {185--209},
