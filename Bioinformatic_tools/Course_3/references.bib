@article{shields_field_1999,
	title = {Field Efficacy and Persistence of the Entomopathogenic Nematodes \textit{Heterorhabditis bacteriophora} ‘Oswego’ and \textit{H. bacteriophora} ‘{NC}’ on Alfalfa Snout Beetle Larvae (Coleoptera: Curculionidae)},
	volume = {28},
	issn = {0046-225X, 1938-2936},
	url = {https://academic.oup.com/ee/article-lookup/doi/10.1093/ee/28.1.128},
	doi = {10.1093/ee/28.1.128},
	shorttitle = {Field Efficacy and Persistence of the Entomopathogenic Nematodes \textit{Heterorhabditis bacteriophora} ‘Oswego’ and \textit{H. bacteriophora} ‘{NC}’ on Alfalfa Snout Beetle Larvae (Coleoptera},
	abstract = {Field {efÞcacy} of 2 strains of entomopathogenic nematode, Heterorhabditis bacteriophora Poinar, were examined against alfalfa snout beetle larvae, Otiorhynchus ligustici (L.), in an established alfalfa Þeld. Both strains were applied at 2.5 and 15 billion {IJs} per hectare using 2 different spray nozzle {conÞgurations}. H. bacteriophora Ô{NCÕ} reduced the insect larval population to 0.33Ð2.3 larvae per 54,900 cm3, {signiÞcantly} below the levels in the untreated controls, and reduced the incidence of snout beetle larval feeding and alfalfa stand death. {NC} occurred in 23Ð70\% of the soil cores during the 1st growing season, but did not persist beyond the 1st growing season. The high rate of H. bcateriophora Ô{OswegoÕ} reduced the insect larval population to 1.3 larvae per 54,900 cm3, {signiÞcantly} below the levels of the untreated controls but not as low as {NC}. Oswego also reduced the incidence of snout beetle larval feeding and alfalfa stand death. Oswego could be found in 73Ð99\% of the soil cores during the 1st growing season and persisted for the entire 700 d of the trial. After 700 d, Oswego could be found in 24 Ð 44\% of the soil cores taken within the treated plots. Evidence of nematode recycling was observed in both nematode strains. Data suggests that the {NC} strain would be more appropriate in situations where a biopesticide is desired, and the Oswego strain is more appropriate where long-term insect suppression is desired within more stable ecosystems.},
	pages = {128--136},
	number = {1},
	journaltitle = {Environmental Entomology},
	author = {Shields, Elson J. and Testa, Antonio and Miller, Joan M. and Flanders, Kathy L.},
	urldate = {2019-05-29},
	date = {1999-02-01},
	langid = {english},
	file = {Shields et al. - 1999 - Field Efficacy and Persistence of the Entomopathog.pdf:/Users/cmaslard/Zotero/storage/4K4U8I2Q/Shields et al. - 1999 - Field Efficacy and Persistence of the Entomopathog.pdf:application/pdf;Shields et al. - 1999 - Field Efficacy and Persistence of the Entomopathog.pdf:/Users/cmaslard/Zotero/storage/57YL4YNL/Shields et al. - 1999 - Field Efficacy and Persistence of the Entomopathog.pdf:application/pdf},
}

@article{georgis_successes_2006,
	title = {Successes and failures in the use of parasitic nematodes for pest control},
	volume = {38},
	issn = {10499644},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S104996440500321X},
	doi = {10.1016/j.biocontrol.2005.11.005},
	abstract = {Advances in mass-production and formulation technology of entomopathogenic nematodes, the discovery of numerous isolates/ strains and the desirability of reducing pesticide usage have resulted in a surge of scientiﬁc and commercial interest in these nematodes. The lessons learned from earlier problems have encouraged scientists and leading commercial companies to increase their eﬀorts toward improving cost eﬃciency and better product positioning in the market within the conﬁnes of product capabilities. The successes or failures of the nematodes against 24 arthropod pest species of agriculture and animals and against a major slug pest in agriculture are discussed in this review. Commercial successes are documented in markets such as citrus (Diaprepes root weevil), greenhouses and glasshouses (black vine weevil, fungus gnats, thrips, and certain borers), turf (white grubs, billbugs, and mole crickets), and mushrooms (sciarid ﬂies). In addition, the successful commercialization of a nematode (Phasmarhabditis hermaphrodita) against slugs in agricultural systems is presented. Despite this progress, the reality is that nematode-based products have limited market share. Limited share is attributed to higher product cost compared to standard insecticides, low eﬃcacy under unfavorable conditions, application timing and conditions, limited data and cost beneﬁt in {IPM} programs, refrigeration requirements and limited room temperature shelf life (product quality), use of suboptimum nematode species, and lack of detail application directions. One or more of these factors aﬀected the market introduction of the nematodes despite promising ﬁeld eﬃcacy against insects such as black cutworm in turf, sugar beet weevil in sugar beet, sweet potato weevil in sweet potato, and house ﬂy adult in animal-rearing farms. Insects such as cabbage root maggots, carrot root weevil, and Colorado potato beetle are listed on the label of certain commercial products despite low eﬃcacy data, due to insect susceptibility, biology, and/or behavior. To make entomopathogenic nematodes more successful, realistic strategies through genetic engineering, {IPM} programs, and new delivery systems and/or training programs to overcome their inherent cost, formulation instability, and limited ﬁeld eﬃcacy toward certain insects are needed.},
	pages = {103--123},
	number = {1},
	journaltitle = {Biological Control},
	author = {Georgis, R. and Koppenhöfer, A.M. and Lacey, L.A. and Bélair, G. and Duncan, L.W. and Grewal, P.S. and Samish, M. and Tan, L. and Torr, P. and van Tol, R.W.H.M.},
	urldate = {2019-04-29},
	date = {2006-07},
	langid = {english},
	keywords = {lue},
	file = {Georgis et al_2006_Successes and failures in the use of parasitic nematodes for pest control.pdf:/Users/cmaslard/Zotero/storage/ASZTAJL7/Georgis et al_2006_Successes and failures in the use of parasitic nematodes for pest control.pdf:application/pdf;Georgis et al. - 2006 - Successes and failures in the use of parasitic nem.pdf:/Users/cmaslard/Zotero/storage/AFSFX64Y/Georgis et al. - 2006 - Successes and failures in the use of parasitic nem.pdf:application/pdf},
}

@article{champion_standardization_2018,
	title = {Standardization of G. mellonella Larvae to Provide Reliable and Reproducible Results in the Study of Fungal Pathogens},
	volume = {4},
	issn = {2309-608X},
	url = {http://www.mdpi.com/2309-608X/4/3/108},
	doi = {10.3390/jof4030108},
	abstract = {In the past decade, Galleria mellonella (wax moth) larvae have become widely used as a non-mammalian infection model. However, the full potential of this infection model has yet to be realised, limited by the variable quality of larvae used and the lack of standardised procedures. Here, we review larvae suitable for research, protocols for dosing larvae, and methods for scoring illness in larvae infected with fungal pathogens. The development of standardised protocols for carrying out our experimental work will allow high throughput screens to be developed, changing the way in which we evaluate panels of mutants and strains. It will also enable the in vivo screening of potential antimicrobials at an earlier stage in the research and development cycle.},
	pages = {108},
	number = {3},
	journaltitle = {Journal of Fungi},
