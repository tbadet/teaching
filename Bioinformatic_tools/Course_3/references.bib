@article{wang_metabolomics_2019,
	title = {Metabolomics reveals the drought-tolerance mechanism in wild soybean (Glycine soja)},
	volume = {41},
	issn = {0137-5881, 1861-1664},
	url = {http://link.springer.com/10.1007/s11738-019-2939-1},
	doi = {10.1007/s11738-019-2939-1},
	series = {2.354},
	abstract = {Drought stress is the main limiting factor of crop productivity. Wild soybean (Glycine soja) is a fine germplasm resource, which has a high tolerance to adverse environmental conditions. This study aimed to reveal the mechanism responsible for drought tolerance in drought-tolerant wild soybean. Here, the growth parameters and metabolomics of the two wild soybean varieties’ seedlings were analyzed under polyethylene glycol-simulated drought stress using gas chromatography–mass spectrometry. In total, 61 differentially accumulated metabolites were identified in leaves under polyethylene glycol6000-simulated drought conditions. Compared with common wild soybean, the drought-tolerant wild soybean grew better. A metabolite profiling analysis suggested that the tricarboxylic acid cycle was enhanced in drought-tolerant wild soybean but inhibited in common wild soybean compared with the control group under simulated drought stress. Thus, the accumulation of osmotic compounds and the enhancement of energy and secondary antioxidant metabolism under drought-stress conditions are the mechanisms responsible for drought tolerance in drought-tolerant wild soybean. The results provide an important theoretical basis for utilizing wild soybean resources.},
	pages = {161},
	number = {9},
	journaltitle = {Acta Physiologiae Plantarum},
	shortjournal = {Acta Physiol Plant},
	author = {Wang, Xiaoxia and Guo, Rui and Li, Mingxia and Liu, Yuan and Zhao, Mingli and Fu, Hui and Liu, Xueying and Wang, Shiyao and Shi, Lianxuan},
	urldate = {2021-12-02},
	date = {2019-09},
	langid = {english},
	keywords = {soybean🌿, drought🚱, metabolomic},
	file = {Wang et al. - 2019 - Metabolomics reveals the drought-tolerance mechani.pdf:/Users/cmaslard/Zotero/storage/3RU72WIA/Wang et al. - 2019 - Metabolomics reveals the drought-tolerance mechani.pdf:application/pdf},
}

