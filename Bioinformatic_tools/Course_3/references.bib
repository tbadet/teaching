	keywords = {/unread, drought🚱, microbial communities🦠},
	file = {Rosa et al. - 2023 - Finding optimal microorganisms to increase crop pr.pdf:/Users/cmaslard/Zotero/storage/DELGBH96/Rosa et al. - 2023 - Finding optimal microorganisms to increase crop pr.pdf:application/pdf},
