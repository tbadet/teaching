	doi = {10.1080/21505594.2015.1135289},
	abstract = {Galleria mellonella (greater wax moth or honeycomb moth) has been introduced as an alternative model to study microbial infections. G. mellonella larvae can be easily and inexpensively obtained in large numbers and are simple to use as they don’t require special lab equipment. There are no ethical constraints and their short life cycle makes them ideal for large-scale studies. Although insects lack an adaptive immune response, their innate immune response shows remarkable similarities with the immune response in vertebrates.},
