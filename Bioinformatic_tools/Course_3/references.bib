	file = {Bernardo et al. - 2017 - Proteomic insight into the mitigation of wheat roo.pdf:/Users/cmaslard/Zotero/storage/W6BQU7J2/Bernardo et al. - 2017 - Proteomic insight into the mitigation of wheat roo.pdf:application/pdf},
}

