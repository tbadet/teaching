	volume = {62},
	issn = {0008-4220, 1918-1833},
	url = {http://www.nrcresearchpress.com/doi/10.4141/cjps82-108},
	doi = {10.4141/cjps82-108},
	series = {1.018},
	abstract = {The influence of root level temperature on the growth and development of tomato was determined under greenhouse conditions using five substrate temperatures for a period of 3 mo. Heaviest production of root tissue was obtained at lower temperatures (13.8 and 18.6 °C), while best shoot production was obtained with the 23.9 °C treatment. The top/root ratio increased with increased substrate temperature, reaching a maximum at 29.3 °C. Highest yields were produced at 23.9 °C, but more because of larger fruit size than increased fruit set. Higher root level temperatures decreased N and increased K and P content of shoots. Magnesium content was highest at 23.9 °C, while Na was lowest. Shoot Fe, Mn, Zn and Cu concentrations were higher at higher substrate temperatures (29.3 and 33.8 °C).},
	pages = {751--757},
	number = {3},
	journaltitle = {Canadian Journal of Plant Science},
	shortjournal = {Can. J. Plant Sci.},
	author = {Gosselin, André and Trudel, Marc J.},
	urldate = {2021-05-04},
