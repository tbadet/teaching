	langid = {english},
	keywords = {microbial communities🦠, endophyte, co-occurence, kingking recomandation, network, root endophyte},
	file = {Banerjee et al. - 2019 - Agricultural intensification reduces microbial net.pdf:/Users/cmaslard/Zotero/storage/22SF6NDX/Banerjee et al. - 2019 - Agricultural intensification reduces microbial net.pdf:application/pdf},
