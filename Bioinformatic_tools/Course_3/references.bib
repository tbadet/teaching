	file = {Yu et al. - 2021 - Impact and mechanism of sulphur-deficiency on mode.pdf:/Users/cmaslard/Zotero/storage/WK6LWHWW/Yu et al. - 2021 - Impact and mechanism of sulphur-deficiency on mode.pdf:application/pdf},
}

@article{etienne_assessment_2018,
	title = {Assessment of Sulfur Deficiency under Field Conditions by Single Measurements of Sulfur, Chloride and Phosphorus in Mature Leaves},
	volume = {7},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2223-7747},
	url = {https://www.mdpi.com/2223-7747/7/2/37},
	doi = {10.3390/plants7020037},
	abstract = {Determination of S status is very important to detect S deficiency and prevent losses of yield and seed quality. The aim of this study was to investigate the possibility of using the ([Cl−]+[{NO}3−]+[{PO}43−]):[{SO}42−] ratio as an indicator of S nutrition under field conditions in Brassica napus and whether this could be applied to other species. Different S and nitrogen (N) fertilizations were applied on a S deficient field of oilseed rape to harvest mature leaves and analyze their anion and element contents in order to evaluate a new S nutrition indicator and useful threshold values. Large sets of commercial varieties were then used to test S deficiency scenarios. As main results, this study shown that, under field conditions, leaf ([Cl−]+[{NO}3−]+[{PO}43−]):[{SO}42−] ratio was increased by lowering S fertilization, indicating S deficiency. The usefulness of this ratio was also found for other species grown under controlled conditions and it could be simplified by using the elemental ([Cl]+[P]):[S] ratio. Threshold values were determined and used for the clustering of commercial varieties within three groups: S deficient, at risk of S deficiency and S sufficient. The ([Cl]+[P]):[S] ratio quantified under field conditions, can be used as an early and accurate diagnostic tool to manage S fertilization.},
	pages = {37},
	number = {2},
	journaltitle = {Plants},
	shortjournal = {Plants},
	author = {Etienne, Philippe and Sorin, Elise and Maillard, Anne and Gallardo, Karine and Arkoun, Mustapha and Guerrand, Jérôme and Cruz, Florence and Yvin, Jean-Claude and Ourry, Alain},
	urldate = {2024-06-12},
	date = {2018-04-28},
	langid = {english},
	file = {Texte intégral:/Users/cmaslard/Zotero/storage/WIM7WIJX/Etienne et al. - 2018 - Assessment of Sulfur Deficiency under Field Condit.pdf:application/pdf},
}

