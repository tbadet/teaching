@article{tejos_patellins_2018,
	title = {{PATELLINS} are regulators of auxin-mediated {PIN}1 relocation and plant development in \textit{Arabidopsis thaliana}},
	volume = {131},
	rights = {http://www.biologists.com/user-licence-1-1/},
	issn = {1477-9137, 0021-9533},
	url = {https://journals.biologists.com/jcs/article/131/2/jcs204198/76991/PATELLINS-are-regulators-of-auxin-mediated-PIN1},
	doi = {10.1242/jcs.204198},
	abstract = {Coordinated cell polarization in developing tissues is a recurrent theme in multicellular organisms. In plants, a directional distribution of the plant hormone auxin is at the core of many developmental programs. A feedback regulation of auxin on the polarized localization of {PIN} auxin transporters in individual cells has been proposed as a self-organizing mechanism for coordinated tissue polarization, but the molecular mechanisms linking auxin signalling to {PIN}-dependent auxin transport remain unknown. We used a microarray-based approach to find regulators of the auxin-induced {PIN} relocation in Arabidopsis thaliana root, and identified a subset of a family of phosphatidylinositol transfer proteins ({PITPs}), the {PATELLINs} ({PATLs}). Here, we show that {PATLs} are expressed in partially overlapping cell types in different tissues going through mitosis or initiating differentiation programs. {PATLs} are plasma membraneassociated proteins accumulated in Arabidopsis embryos, primary roots, lateral root primordia and developing stomata. Higher order patl mutants display reduced {PIN}1 repolarization in response to auxin, shorter root apical meristem, and drastic defects in embryo and seedling development. This suggests that {PATLs} play a redundant and crucial role in polarity and patterning in Arabidopsis.},
	pages = {jcs204198},
	number = {2},
	journaltitle = {Journal of Cell Science},
	author = {Tejos, Ricardo and Rodriguez-Furlán, Cecilia and Adamowski, Maciej and Sauer, Michael and Norambuena, Lorena and Friml, Jiří},
	editor = {Russinova, Jenny},
	urldate = {2025-08-05},
	date = {2018-01-15},
	langid = {english},
	file = {PDF:/Users/cmaslard/Zotero/storage/EKLWVJ8Y/Tejos et al. - 2018 - PATELLINS are regulators of auxin-mediated PIN1 relocation and plant development in Arabidopsis t.pdf:application/pdf},
}

