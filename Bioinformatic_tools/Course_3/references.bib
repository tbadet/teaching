@article{sionit_interaction_1987,
	title = {{INTERACTION} {OF} {TEMPERATURE} {AND} {CO} $_{\textrm{2}}$ {ENRICHMENT} {ON} {SOYBEAN}: {GROWTH} {AND} {DRY} {MATTER} {PARTITIONING}},
	volume = {67},
	issn = {0008-4220, 1918-1833},
	url = {http://www.nrcresearchpress.com/doi/10.4141/cjps87-007},
	doi = {10.4141/cjps87-007},
	series = {1.018},
	shorttitle = {{INTERACTION} {OF} {TEMPERATURE} {AND} {CO} $_{\textrm{2}}$ {ENRICHMENT} {ON} {SOYBEAN}},
	abstract = {Projected increases in atmospheric {CO}, concentration will affect growth and productivity of many plant species under various environmental conditions. Since these increases in {COr} may also increase mean annual temperatures, it is important to determine how the soybean (Glycine rurr (L.) Merr.) will respond to changes in temperature regimes associated with atmospheric {CO}2 enrichment. Morphology and growth responses of the Ransom cultivar, which is adapted to a southern U.S.A. climate, to day/night temperature regimes of 18112, 22116, and,26l2O'C and atmospheric {CO}, concentrations of 350, 6'75 and 1000 prl L t were studied in controlled environment chambers. Plant responses were determined at 20, 40,67 and 115 (late senescence to maturity) days aller planting. Plant height and number of branches increased slightly with {CO}, enrichment and more significantly with increasing temperature. Root to shoot ratio remained unchanged at different {CO}2 concentrations but decreased as temperature increased. Leaf weight ratio and specific leaf weight decreased with increasing temperature. Low temperature reduced dry weight of all plant parts, but the reduction was ameliorated by increasing atmospheric {CO}, concentration. The results show that increasing the atmospheric {CO}, level causes soybean to grow more vigorously at low temperatures. Although controlled environment experiments have their drawbacks in regard to natural field conditions, the present data indicate that soybean will have enhanced growth even at moderately cool temperatures in the future global {CO}2 concentratlons.},
	pages = {59--67},
	number = {1},
	journaltitle = {Canadian Journal of Plant Science},
	shortjournal = {Can. J. Plant Sci.},
	author = {Sionit, Nasser and Strain, B. R. and Flint, E. P.},
	urldate = {2021-06-09},
	date = {1987-01-01},
	langid = {english},
	keywords = {soybean🌿, {CO}2, cold🧊},
	file = {Sionit et al. - 1987 - INTERACTION OF TEMPERATURE AND CO 2 ENR.pdf:/Users/cmaslard/Zotero/storage/ZIBR3ICZ/Sionit et al. - 1987 - INTERACTION OF TEMPERATURE AND CO 2 ENR.pdf:application/pdf},
