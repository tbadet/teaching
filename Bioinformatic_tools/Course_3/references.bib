}

@article{yu_soybean_nodate,
	title = {Soybean nuclear factor {YA}10 positively regulates drought resistance in transgenic {\textless}em{\textgreater}Arabidopsis thaliana{\textless}/em{\textgreater}},
	url = {https://www.sciencedirect.com/science/article/pii/S0098847220302756?dgcid=rss_sd_all&utm_source=researcher_app&utm_medium=referral&utm_campaign=RESR_MRKT_Researcher_inbound},
	doi = {10.1016/j.envexpbot.2020.104249},
	abstract = {{\textless}p{\textgreater}Nuclear factor ({NF})-Y is composed of three subunits, {NF}-{YA}, {NF}-{YB} and {NF}-{YC}, and plays important roles in the regulation of plant abiotic stress response gene expression. However, the function of individual soybean {NF}-{YA} proteins in response to drought stress is unclear. In this study, the soybean {NF}-{YA} subunit gene {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} was cloned, and its function in response to drought stress was identified. {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} is broadly expressed in soybean tissues and is specifically located in the nucleus. In soybean roots, the transcription level of the {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} gene was induced by polyethylene glycol ({PEG})-simulated drought stress and abscisic acid ({ABA}) treatment. Under mannitol stress, the germination rate of transgenic {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater} overexpressing {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} was higher than that of wild-type ({WT}) {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater}. After drought stress, the survival rate, relative water content, {ABA} content, proline content and chlorophyll content of transgenic {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater} overexpressing {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} were higher than those of {WT} {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater} while the rate of water loss and the contents of malondialdehyde and sucrose were lower than those of {WT} {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater}, indicating that transgenic {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater} overexpressing {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} has better drought resistance than {WT} {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater}. Under the {ABA} treatment, the root length of transgenic {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater} overexpressing {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} was shorter than that of {WT} {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater} and the degree of stomatal closure was greater than that of {WT} {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater}, indicating that transgenic {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater} overexpressing {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} was more sensitive to {ABA} at the post-germination stage. Transcriptome sequencing and real-time quantitative {PCR} analysis showed that {\textless}em{\textgreater}{GmNF}-{YA}10{\textless}/em{\textgreater} affected the expression of both {ABA}-dependent and {ABA}-independent signalling pathway genes. These results indicate that {GmNF}-{YA}10 significantly improves the drought resistance of transgenic {\textless}em{\textgreater}Arabidopsis{\textless}/em{\textgreater} through {ABA}-dependent and {ABA}-independent signal transduction pathways.{\textless}/p{\textgreater}},
	journaltitle = {Environmental and Experimental Botany},
	author = {Yu, Yuehua and Bai, Yucui and Wang, Ping and Wang, Yi and Wan, Huina and Liu, Chen and Ni, Zhiyong},
	keywords = {Researcher App},
}

@article{xiong_root_nodate,
	title = {Root system architecture, physiological and transcriptional traits of soybean (Glycine max L.) in response to water deficit: A review},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ppl.13201?af=R&utm_source=researcher_app&utm_medium=referral&utm_campaign=RESR_MRKT_Researcher_inbound},
	doi = {10.1111/ppl.13201},
	abstract = {{\textless}p{\textgreater}Drought stress is the main limiting factor for global soybean growth and production. Genetic improvement for water and nutrient uptake efficiency is critical to advance tolerance and enable more sustainable and resilient production, underpinning yield growth. The identification of quantitative traits and genes related to water and nutrient uptake will enhance our understanding of the mechanisms of drought tolerance in soybean. This review summarizes drought stress in the context of the physiological traits that enable effective acclimation, with a particular focus on roots. Genes controlling root system architecture play an important role in water and nutrient availability, and therefore important targets for breeding strategies to improve drought tolerance. This review highlights the candidate genes that have been identified as regulators of important root traits and responses to water stress. Progress in our understanding of the function of particular genes, including, \textit{{GmACX}1}, \textit{{GmMS}} and \textit{{GmPEPCK}} are discussed in the context of developing a system‐based platform for genetic improvement of drought tolerance in soybean.{\textless}/p{\textgreater}
{\textless}p{\textgreater}This article is protected by copyright. All rights reserved.{\textless}/p{\textgreater}},
	journaltitle = {Physiologia Plantarum},
	author = {Xiong, Rentao and Liu, Shuo and Considine, Michael J and Siddique, Kadambot {HM} and Lam, Hon‐Ming and Chen, Yinglong},
	keywords = {Researcher App, root architecture🕸, soybean🌿, drought🚱, print, transcriptomics, review, physiologie},
	file = {Xiong et al. - 2020 - Root system architecture, physiological and transc.pdf:/Users/cmaslard/Zotero/storage/8BEE85M6/Xiong et al. - 2020 - Root system architecture, physiological and transc.pdf:application/pdf},
}

