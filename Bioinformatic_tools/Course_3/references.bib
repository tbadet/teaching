	urldate = {2024-01-30},
	date = {2018-08-02},
	langid = {english},
	file = {De Vries et al. - 2018 - Soil bacterial networks are less stable under drou.pdf:/Users/cmaslard/Zotero/storage/7D8FSSMU/De Vries et al. - 2018 - Soil bacterial networks are less stable under drou.pdf:application/pdf},
