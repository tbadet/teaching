	date = {2001-03},
	langid = {english},
	keywords = {lue},
	file = {Boff et al. - 2001 - Orientation of Heterorhabditis megidis to insect h.pdf:/Users/cmaslard/Zotero/storage/CKFHFL4Y/Boff et al. - 2001 - Orientation of Heterorhabditis megidis to insect h.pdf:application/pdf;Boff et al. - 2001 - Orientation of Heterorhabditis megidis to insect h.pdf:/Users/cmaslard/Zotero/storage/EZ26QDMT/Boff et al. - 2001 - Orientation of Heterorhabditis megidis to insect h.pdf:application/pdf},
