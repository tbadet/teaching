@article{shim_drought-induced_2023,
	title = {{DROUGHT}-{INDUCED} {BRANCHED}-{CHAIN} {AMINO} {ACID} {AMINOTRANSFERASE} enhances drought tolerance in rice},
	volume = {191},
	rights = {https://academic.oup.com/pages/standard-publication-reuse-rights},
	issn = {0032-0889, 1532-2548},
	url = {https://academic.oup.com/plphys/article/191/2/1435/6885549},
	doi = {10.1093/plphys/kiac560},
	abstract = {Plants accumulate several metabolites in response to drought stress, including branched-chain amino acids ({BCAAs}). However, the roles of {BCAAs} in plant drought responses and the underlying molecular mechanisms for {BCAA} accumulation remain elusive. Here, we demonstrate that rice (Oryza sativa) {DROUGHT}-{INDUCED} {BRANCHED}-{CHAIN} {AMINO} {ACID} {AMINOTRANSFERASE} ({OsDIAT}) mediates the accumulation of {BCAAs} in rice in response to drought stress. An in vitro enzyme activity assay indicated that {OsDIAT} is a branched-chain amino acid aminotransferase, and subcellular localization analysis revealed that {OsDIAT} localizes to the cytoplasm. The expression of {OsDIAT} was induced in plants upon exposure to abiotic stress. {OsDIAT}-overexpressing ({OsDIATOX}) plants were more tolerant to drought stress, whereas osdiat plants were more susceptible to drought stress compared with nontransgenic ({NT}) plants. Amino acid analysis revealed that {BCAA} levels were higher in {OsDIATOX} but lower in osdiat com­ pared with in {NT} plants. Finally, the exogenous application of {BCAAs} improved plant tolerance to osmotic stress compared with that in control plants. Collectively, these findings suggest that {OsDIAT} mediates drought tolerance by promoting the accumu­ lation of {BCAAs}.},
	pages = {1435--1447},
	number = {2},
	journaltitle = {Plant Physiology},
	author = {Shim, Jae Sung and Jeong, Hye In and Bang, Seung Woon and Jung, Se Eun and Kim, Goeun and Kim, Youn Shic and Redillas, Mark Christian Felipe R and Oh, Se-Jun and Seo, Jun Sung and Kim, Ju-Kon},
	urldate = {2024-06-28},
	date = {2023-02-12},
	langid = {english},
	file = {Shim et al. - 2023 - DROUGHT-INDUCED BRANCHED-CHAIN AMINO ACID AMINOTRA.pdf:/Users/cmaslard/Zotero/storage/23BFDHHB/Shim et al. - 2023 - DROUGHT-INDUCED BRANCHED-CHAIN AMINO ACID AMINOTRA.pdf:application/pdf},
}

@article{krasensky_drought_2012,
	title = {Drought, salt, and temperature stress-induced metabolic rearrangements and regulatory networks},
