	abstract = {What determines the way in which roots provide carbon to and interact with other components of the soil? Roots lose metabolites and signal molecules to the soil at rates of signiﬁcance to soil organisms, and we need to know if the mechanisms of passive diffusion identiﬁed in hydroponics apply in soil, and whether other, active mechanisms complement them. New insights from biosensors into the heterogeneity and localization of exudation are transforming our understanding of root–microorganism relations. We need to know more about compounds that are exuded at subnutritional rates in soil and may act as signal molecules modifying the biology of soil organisms. Insights into one suite of such compounds is coming from studies of border cells. These cells are lost from the root cap at a rate regulated by the root and secrete compounds that alter the environment of and gene expression in soil microorganisms and fauna. The amount of root places an upper limit on the effect roots can have; carbon ﬂow to the rhizosphere is a function of root growth. Top-down metabolic control analysis shows that the control over the rate at which roots grow is shared between root and shoot, with most control being in the shoot.},
	pages = {827--837},
	number = {4},
	journaltitle = {Ecology},
	shortjournal = {Ecology},
	author = {Farrar, John and Hawes, Martha and Jones, Davey and Lindow, Steven},
	urldate = {2024-06-20},
	date = {2003-04},
	langid = {english},
	file = {Farrar et al. - 2003 - HOW ROOTS CONTROL THE FLUX OF CARBON TO THE RHIZOS.pdf:/Users/cmaslard/Zotero/storage/K2CY7TUV/Farrar et al. - 2003 - HOW ROOTS CONTROL THE FLUX OF CARBON TO THE RHIZOS.pdf:application/pdf},
}

@article{hennion_sugars_2019,
	title = {Sugars en route to the roots. Transport, metabolism and storage within plant roots and towards microorganisms of the rhizosphere},
	volume = {165},
	issn = {0031-9317, 1399-3054},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/ppl.12751},
	doi = {10.1111/ppl.12751},
	abstract = {In plants, the root is a typical sink organ  that relies exclusively on the import of sugar from the aerial parts. Sucrose is delivered by the phloem to the most distant root tips and, en route to the tip, is used by the different root tissues for metabolism and storage. Besides, a certain portion of this carbon is exuded in the rhizosphere, supplied to beneficial microorganisms and diverted by parasitic microbes. The transport of sugars toward these numerous sinks either occurs symplastically through cell connections (plasmodesmata) or is apoplastically mediated through membrane transporters ({MST}, mononsaccharide tranporters, {SUT}/{SUC}, H+/sucrose transporters and {SWEET}, Sugar will eventually be exported transporters)
 that control monosaccharide and sucrose fluxes. Here, we review recent progresses on carbon partitioning within and outside roots, discussing membrane transporters involved in plant responses to biotic and abiotic factors.},
	pages = {44--57},
	number = {1},
	journaltitle = {Physiologia Plantarum},
	shortjournal = {Physiologia Plantarum},
	author = {Hennion, Nils and Durand, Mickael and Vriet, Cécile and Doidy, Joan and Maurousset, Laurence and Lemoine, Rémi and Pourtau, Nathalie},
	urldate = {2024-06-20},
	date = {2019-01},
	langid = {english},
}

@article{haichar_root_2014,
	title = {Root exudates mediated interactions belowground},
	volume = {77},
	issn = {00380717},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0038071714002284},
	doi = {10.1016/j.soilbio.2014.06.017},
	abstract = {The root exudate composition reﬂects the contradictory-concomitantly attractive and repulsivebehaviour of plants towards soil microorganisms. Plants produce antimicrobial, insecticide and nematicide compounds to repel pathogens and invaders. They also produce border cells that detach from roots and play an important role as biological and physical barrier against aggressors. Plants produce also metabolites used as carbon source resulting in the attraction of phytobeneﬁcial soil microorganisms that help plants in controlling diseases directly via the production of antimicrobial compounds or indirectly via the induction of plant systemic resistance. The root exudates may have a direct impact on carbon and nitrogen cycling, as they exhibit a rhizosphere priming effect towards soil organic matter degraders, and may inhibit nitriﬁcation process by soil nitrifying microorganisms. They also contain signalling molecules required for the establishment of ‘plant-microorganisms’ interactions. The composition of root exudates is therefore broad ranging, consisting of feeding, antimicrobial and signalling molecules. We thus focused this review on current research concerning the role of the root exudate composition in ‘plant-microorganisms’ interactions and functioning of the rhizosphere.},
	pages = {69--80},
	journaltitle = {Soil Biology and Biochemistry},
	shortjournal = {Soil Biology and Biochemistry},
	author = {Haichar, Feth El Zahar and Santaella, Catherine and Heulin, Thierry and Achouak, Wafa},
	urldate = {2024-01-29},
	date = {2014-10},
	langid = {english},
	file = {Haichar et al. - 2014 - Root exudates mediated interactions belowground.pdf:/Users/cmaslard/Zotero/storage/YTENT9V3/Haichar et al. - 2014 - Root exudates mediated interactions belowground.pdf:application/pdf},
}

