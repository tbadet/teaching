	langid = {english},
	file = {Ali et al. - 2020 - Implications of Abscisic Acid in the Drought Stres.pdf:/Users/cmaslard/Zotero/storage/QF2UX7F2/Ali et al. - 2020 - Implications of Abscisic Acid in the Drought Stres.pdf:application/pdf},
