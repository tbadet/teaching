@article{gal_differential_2003,
	title = {{DIFFERENTIAL} {GENE} {EXPRESSION} {DURING} {DESICCATION} {STRESS} {IN} {THE} {INSECT}-{KILLING} {NEMATODE} {STEINERNEMA} {FELTIAE} {IS}-6},
	volume = {89},
	issn = {0022-3395, 1937-2345},
	url = {http://www.bioone.org/doi/abs/10.1645/GE-3105},
	doi = {10.1645/GE-3105},
	abstract = {The developmentally arrested life stage of the entomopathogenic nematode Steinernema feltiae is exposed to threats of survival, including desiccation. We adopted a comprehensive approach to the study of the molecular mechanisms of desiccation stress tolerance in S. feltiae {IS}-6. We identiﬁed, expressed sequence tags ({ESTs}) that are differentially expressed during desiccation stress in S. feltiae {IS}-6 infective juveniles using {DNA} subtractive hybridization. These {ESTs} included genes that are known to be stress related, genes that are homologous to hypothetical Caenorhabditis elegans proteins, and novel genes that may be involved in traits speciﬁc to S. feltiae. Expression pattern characterization revealed that all analyzed {ESTs} were induced during 8 and 24 hr of dehydration of S. feltiae {IS}-6. Our results unveiled some of the components of the genetic networks that are activated in S. feltiae {IS}-6 during dehydration and suggested a differing pattern of temporal regulation during nematode dehydration.},
	pages = {761--766},
	number = {4},
	journaltitle = {Journal of Parasitology},
	author = {Gal, Tali Z. and Glazer, Itamar and Koltai, Hinanit},
	urldate = {2019-04-23},
	date = {2003-08},
	langid = {english},
	keywords = {lue, steinernema feltiae},
	file = {Gal et al_2003_DIFFERENTIAL GENE EXPRESSION DURING DESICCATION STRESS IN THE INSECT-KILLING.pdf:/Users/cmaslard/Zotero/storage/ZMSK9K6V/Gal et al_2003_DIFFERENTIAL GENE EXPRESSION DURING DESICCATION STRESS IN THE INSECT-KILLING.pdf:application/pdf;Gal et al. - 2003 - DIFFERENTIAL GENE EXPRESSION DURING DESICCATION ST.pdf:/Users/cmaslard/Zotero/storage/UQ4R7LJB/Gal et al. - 2003 - DIFFERENTIAL GENE EXPRESSION DURING DESICCATION ST.pdf:application/pdf;Gal et al. - 2003 - DIFFERENTIAL GENE EXPRESSION DURING DESICCATION ST.pdf:/Users/cmaslard/Zotero/storage/GJ8KEE3Y/Gal et al. - 2003 - DIFFERENTIAL GENE EXPRESSION DURING DESICCATION ST.pdf:application/pdf},
