	title = {Integrated multi‐omics analysis reveals drought stress response mechanism in chickpea ( \textit{Cicer arietinum} L.)},
	issn = {1940-3372, 1940-3372},
	url = {https://acsess.onlinelibrary.wiley.com/doi/10.1002/tpg2.20337},
