	date = {2004-07-15},
	langid = {english},
	file = {Kalifa et al_2004_The water- and salt-stress-regulated iAsr1-i (abscisic acid stress.PDF:/Users/cmaslard/Zotero/storage/LXNQK38N/Kalifa et al_2004_The water- and salt-stress-regulated iAsr1-i (abscisic acid stress.PDF:application/pdf;Kalifa et al. - 2004 - The water- and salt-stress-regulated iAsr1i (.PDF:/Users/cmaslard/Zotero/storage/P6XUAJA4/Kalifa et al. - 2004 - The water- and salt-stress-regulated iAsr1i (.PDF:application/pdf},
