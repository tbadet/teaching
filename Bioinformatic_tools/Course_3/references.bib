	abstract = {Edaphic factors such as soil temperature and moisture inßuence soil-dwelling insects, whose most vulnerable stages typically are eggs and young larvae. In this study, the survival of eggs and Þrst-instar larvae of the cabbage maggot, Delia radicum L., was measured under laboratory conditions after exposure to a range of soil temperatures and moistures. When eggs were exposed to constant temperature (20 Ð29{ЊC}) and humidity (5Ð200\% [wt:wt]), temperature had no {signiÞcant} effect on survival, whereas humidity Ͻ25\% [wt:wt] caused egg mortality. The gradual exposure of eggs to high temperatures resulted in low mortality below 33{ЊC}, but Ͻ5\% of eggs survived at 40{ЊC}. When Þrst-instar larvae were exposed to constant temperature (17Ð29{ЊC}) and humidity (5Ð100\% [wt:wt]), both factors as well as their interaction had a {signiÞcant} effect on larval survival, which was nil at 5\% (wt:wt) for all temperatures but increased from 21.9 to 42.8\% at 17{ЊC} and from 34.1 to 55.0\% at 29{ЊC}, for soil moisture contents of 15\% and 100\% (wt:wt), respectively. Eggs of D. radicum are resistant to low soil moisture and high temperature conditions. Larval survival tends to increase with an increase in soil temperature and moisture. It is suggested that soil temperature be integrated into insect development simulation models instead of air temperature, to build more effective models for cabbage maggot management.},
	pages = {159--165},
	number = {1},
	journaltitle = {Environmental Entomology},
	author = {Lepage, M. P. and Bourgeois, G. and Brodeur, J. and Boivin, G.},
	urldate = {2019-06-24},
	date = {2012-02-01},
	langid = {english},
	file = {Lepage et al. - 2012 - Effect of Soil Temperature and Moisture on Surviva.pdf:/Users/cmaslard/Zotero/storage/FL2CP2DY/Lepage et al. - 2012 - Effect of Soil Temperature and Moisture on Surviva.pdf:application/pdf;Lepage et al. - 2012 - Effect of Soil Temperature and Moisture on Surviva.pdf:/Users/cmaslard/Zotero/storage/VVALZTZY/Lepage et al. - 2012 - Effect of Soil Temperature and Moisture on Surviva.pdf:application/pdf},
}

@article{chen_effect_2003,
	title = {Effect of temperature on the pathogenicity of entomopathogenic nematodes (Steinernema and Heterorhabditis spp.) to Delia radicum},
	abstract = {Susceptibility of last instar larvae of Delia radicum to Steinernema feltiae, S. carpocapsae, S. arenarium, Heterorhabditis megidis and H. bacteriophora was evaluated in the laboratory at 10 ◦C, 15 ◦C and 20 ◦C. S. feltiae was the only species that killed the larvae at 10 ◦C; S. carpocapsae, S. arenarium and H. megidis were effective at 15–20 ◦C whereas H. bacteriophora killed the maggot only at 20 ◦C. The temperature signiﬁcantly affected the host searching ability of all tested species. Mobility was reduced at low temperatures. Signiﬁcant effects of the host presence on nematode mobility were found for S. feltiae, S. arenarium and H. megidis but not for S. carpocapsae and H. bacteriophora. The dynamics of the attachment to and penetration into the host were monitored for S. feltiae at 10 ◦C, 15 ◦C or 20 ◦C and for S. carpocapsae at 20 ◦C. In the period of 6–30 hours after inoculation, S. carpocapsae attached in higher number at 20 ◦C than did S. feltiae at all temperatures. At 20 ◦C, S. carpocapsae penetrated the host only after 30 hours while S. feltiae penetrated already after 15, 9, 6 hours at 10 ◦C, 15 ◦C and 20 ◦C, respectively.},
	pages = {12},
	author = {Chen, S and Li, J and Han, X and Moens, M},
	date = {2003},
	langid = {english},
	file = {Chen et al. - Effect of temperature on the pathogenicity of ento.pdf:/Users/cmaslard/Zotero/storage/KXFA5DUF/Chen et al. - Effect of temperature on the pathogenicity of ento.pdf:application/pdf;Chen et al. - Effect of temperature on the pathogenicity of ento.pdf:/Users/cmaslard/Zotero/storage/9Z3FZU2E/Chen et al. - Effect of temperature on the pathogenicity of ento.pdf:application/pdf},
}

