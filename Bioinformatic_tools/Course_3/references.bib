	urldate = {2019-06-22},
	date = {2016},
	langid = {english},
	doi = {10.1007/978-3-319-27455-3_16},
	keywords = {lue},
	file = {Khan et al. - 2016 - Entomopathogenic Nematodes for the Management of S.pdf:/Users/cmaslard/Zotero/storage/HQGQ34EY/Khan et al. - 2016 - Entomopathogenic Nematodes for the Management of S.pdf:application/pdf;Khan et al. - 2016 - Entomopathogenic Nematodes for the Management of S.pdf:/Users/cmaslard/Zotero/storage/CXD9B7CS/Khan et al. - 2016 - Entomopathogenic Nematodes for the Management of S.pdf:application/pdf},
