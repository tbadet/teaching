	langid = {english},
	file = {PDF:/Users/cmaslard/Zotero/storage/G6SYZMMG/Maslard et al. - 2021 - Root architecture characterization in relation to biomass allocation and biological nitrogen fixatio.pdf:application/pdf},
}

