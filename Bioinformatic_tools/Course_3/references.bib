@article{javot_phosphate_2007,
	title = {Phosphate in the arbuscular mycorrhizal symbiosis: transport properties and regulatory roles},
	volume = {30},
	issn = {0140-7791, 1365-3040},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/j.1365-3040.2006.01617.x},
	doi = {10.1111/j.1365-3040.2006.01617.x},
	shorttitle = {Phosphate in the arbuscular mycorrhizal symbiosis},
	abstract = {In response to the colonization by arbuscular mycorrhizal ({AM}) fungi, plants reprioritize their phosphate (Pi)-uptake strategies to take advantage of nutrient transfer via the fungus. The mechanisms underlying Pi transport are beginning to be understood, and recently, details of the regulation of plant and fungal Pi transporters in the {AM} symbiosis have been revealed. This review summarizes recent advances in this area and explores current data and hypotheses of how the plant Pi status affects the symbiosis. Finally, suggestions of an interrelationship of Pi and nitrogen (N) in the {AM} symbiosis are discussed.},
	pages = {310--322},
	number = {3},
	journaltitle = {Plant, Cell \& Environment},
