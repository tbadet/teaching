@article{poinar_history_2012,
	title = {History of Entomopathogenic Nematology},
	abstract = {The history of entomopathogenic nematology is brieﬂy reviewed. Topic selections include early descriptions of members of Steinernema and Heterorhabditis, how only morphology was originally used to distinguish between the species; descriptions of the symbiotic bacteria and elucidating their role in the nematode- insect complex, including antibiotic properties, phase variants, and impeding host defense responses. Other topics include early solutions regarding production, storage, ﬁeld applications and the ﬁrst commercial sales of entomopathogenic nematodes in North America. Later studies centered on how the nematodes locate insect hosts, their effects on non-target organisms and susceptibility of the infective juveniles to soil microbes. While the goals of early workers was to increase the efﬁcacy of entomopathogenic nematodes for pest control, the increasing use of Heterorhabditis and Photorhabdus as genetic models in molecular biology is noted.},
	pages = {9},
	author = {Poinar, G O {JO}},
	date = {2012},
	langid = {english},
	keywords = {steinernema, Heterorhabditis, history, symbiose, Xenorhabdus},
