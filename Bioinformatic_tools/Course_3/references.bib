@article{jaklitsch_disentangling_2013,
	title = {Disentangling the {\textless}I{\textgreater}Trichoderma{\textless}/I{\textgreater} {\textless}I{\textgreater}viridescens{\textless}/I{\textgreater} complex},
	volume = {31},
	issn = {00315850},
	url = {http://openurl.ingenta.com/content/xref?genre=article&issn=0031-5850&volume=31&issue=1&spage=112},
	doi = {10.3767/003158513X672234},
	abstract = {Trichoderma viridescens is recognised as a species complex. Multigene analyses based on the translation elongation factor 1-alpha encoding gene (tef1), a part of the rpb2 gene, encoding the second largest {RNA} polymerase subunit and the larger subunit of {ATP} citrate lyase (acl1) reveals 13 phylogenetic species with little or no phenotypic differentiation. This is the ﬁrst use of acl1 in Trichoderma phylogenetics. The typiﬁcation of T. viridescens s.str. is clariﬁed and Hypocrea viridescens is replaced by the new name T. paraviridescens. Besides these two species, eleven are phylogenetically recognised and T. olivascens, T. viridarium, T. virilente, T. trixiae, T. viridialbum, T. appalachiense, T. neosinense, T. composticola, T. nothescens and T. sempervirentis are formally described and illustrated. Several species produce yellow diffusing pigment on cornmeal dextrose agar, particularly after storage at 15 °C, while T. olivascens is characterised by the formation of an olivaceous pigment. The results are compared with earlier publications on this group of species.},
	pages = {112--146},
	number = {1},
	journaltitle = {Persoonia - Molecular Phylogeny and Evolution of Fungi},
	author = {Jaklitsch, W. M. and Samuels, G. J. and Ismaiel, A. and Voglmayr, H.},
	urldate = {2018-06-13},
	date = {2013-12-31},
	langid = {english},
	file = {Jaklitsch et al. - 2013 - Disentangling the ITrichodermaI Iviridescen.pdf:/Users/cmaslard/Zotero/storage/ZC3F4SFR/Jaklitsch et al. - 2013 - Disentangling the ITrichodermaI Iviridescen.pdf:application/pdf;Jaklitsch et al. - 2013 - Disentangling the ITrichodermaI Iviridescen.pdf:/Users/cmaslard/Zotero/storage/8GJZPLXD/Jaklitsch et al. - 2013 - Disentangling the ITrichodermaI Iviridescen.pdf:application/pdf},
