	langid = {english},
	keywords = {drought🚱, heat stress 🔥, exudate, metabolomic, microbial communities🦠, maize, advised\_by\_aude, root exudates, exsudation},
	file = {1-s2.0-S0098847222002933-mmc6_lrg.jpg:/Users/cmaslard/Zotero/storage/HZLMLACD/1-s2.0-S0098847222002933-mmc6_lrg.jpg:image/jpeg;supplemental material 1.html:/Users/cmaslard/Zotero/storage/X5LVCQ76/supplemental material 1.html:text/html;Tiziani et al. - 2022 - Drought, heat, and their combination impact the ro.pdf:/Users/cmaslard/Zotero/storage/BNSFXS35/Tiziani et al. - 2022 - Drought, heat, and their combination impact the ro.pdf:application/pdf},
