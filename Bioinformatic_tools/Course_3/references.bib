@article{cuthbertson_efficacy_2007,
	title = {Efficacy of the entomopathogenic nematode, Steinernema feltiae, against sweetpotato whitefly Bemisia tabaci (Homoptera: Aleyrodidae) under laboratory and glasshouse conditions},
	volume = {97},
	issn = {0007-4853, 1475-2670},
	url = {http://www.journals.cambridge.org/abstract_S0007485307004701},
	doi = {10.1017/S0007485307004701},
	shorttitle = {Efficacy of the entomopathogenic nematode, Steinernema feltiae, against sweetpotato whitefly Bemisia tabaci (Homoptera},
	abstract = {The potential of using the entomopathogenic nematode Steinernema feltiae to control the sweetpotato whiteﬂy Bemisia tabaci (Gennadius) has been established in previous laboratory studies. However, laboratory studies can overestimate the level of control achieved by biocontrol agents in the glasshouse. Glasshouse trials are therefore required to conﬁrm laboratory results before full-scale commercial development is considered. Under both controlled laboratory and glasshouse conditions high mortality of second instar B. tabaci ({\textgreater} 90\% and {\textgreater} 80\%, respectively) was recorded after application of S. feltiae. The efﬁcacy of the biocontrol agent at various application rates was also investigated, where halving the rate of S. feltiae application caused no signiﬁcant reduction in B. tabaci mortality on tomato foliage. Steinernema feltiae has shown much potential for incorporation into integrated pest management strategies for the control of B. tabaci.},
	pages = {9},
	number = {1},
	journaltitle = {Bulletin of Entomological Research},
	author = {Cuthbertson, A.G.S. and Walters, K.F.A. and Northing, P. and Luo, W.},
	urldate = {2019-04-23},
	date = {2007-01},
	langid = {english},
	keywords = {lue, steinernema feltiae},
	file = {Cuthbertson et al_2007_Efficacy of the entomopathogenic nematode, Steinernema feltiae, against.pdf:/Users/cmaslard/Zotero/storage/7KCSL3MT/Cuthbertson et al_2007_Efficacy of the entomopathogenic nematode, Steinernema feltiae, against.pdf:application/pdf;Cuthbertson et al. - 2007 - Efficacy of the entomopathogenic nematode, iStei.pdf:/Users/cmaslard/Zotero/storage/62REWJLS/Cuthbertson et al. - 2007 - Efficacy of the entomopathogenic nematode, iStei.pdf:application/pdf;Cuthbertson et al. - 2007 - Efficacy of the entomopathogenic nematode, Steiner.pdf:/Users/cmaslard/Zotero/storage/SH42TWLN/Cuthbertson et al. - 2007 - Efficacy of the entomopathogenic nematode, Steiner.pdf:application/pdf},
